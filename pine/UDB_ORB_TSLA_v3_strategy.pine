//@version=6
strategy("UDB-ORB TSLA v3.9.16 STRATEGY — A1/B1/C1/C2/D1 Profiles", shorttitle="UDB-ORB v3.9.16 S", overlay=true,
     process_orders_on_close = true,      // market orders fill at the SIGNAL BAR'S CLOSE (alerts-only realism)
     calc_on_every_tick      = false,
     pyramiding              = 0,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     initial_capital         = 10000,     // $10,000 retail account (default): 25 sh TSLA (~$400) ~= $10k, ~1x
     margin_long             = 0,
     margin_short            = 0,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0,
     slippage                = 0,          // Python charges $0.10/unit on exits; set TV ~10 ticks to match
     max_labels_count        = 500,
     max_lines_count         = 500)

// v3.9.16 2026-08-20 - ALL-RUNNER IS NOW THE DEFAULT (the box added in v3.9.15 ships TICKED).
//     Nothing is taken at the adaptive target -- its touch only ARMS the runner -- and 100% of the
//     position leaves on ONE exit. A1/B1/C1 therefore join D1, which has run this way since v3.6,
//     so all four profiles now scale out zero and exit once. C2 is unchanged (it never had a
//     partial). No logic moved in this version: the ONLY change is the default of `allRunner`
//     from false to true, plus the wording that described the old default.
//     WHY (measured 2026-08-20, Python engine, 2022-01-03..2026-08-19 @60 shares, $0.10/share):
//       A1 $28,450 -> $31,664 (+11.3%)  net/DD 5.76 -> 6.62
//       B1 $31,507 -> $35,772 (+13.5%)  net/DD 8.23 -> 9.03
//       C1 $31,389 -> $35,754 (+13.9%)  net/DD 7.89 -> 8.32
//       D1 bit-identical (already all-runner -- that equality is the check on the port)
//     Past 3 years +11.7% to +12.6%. It improves the 2022-23 out-of-sample years, the 2024-25 fit
//     window AND the 2026 holdout at the same time on all three profiles, which is the whole case
//     for adopting it; the trade COUNT is identical, so this changes exit quantity, not signals.
//     WHAT IT COSTS, stated: the win rate FALLS (B1 46.0 -> 44.3%, C1 47.5 -> 44.1%, A1 46.8 ->
//     45.6%) because the banked partial no longer rescues a marginal trade into the green, while
//     the average winner grows (B1 $4.19 -> $4.54/share). B1's day-level delta is 160 days UP
//     against 185 DOWN for +71.1/unit (ex-top-3 +56.7) -- the gain is MAGNITUDE, not frequency,
//     so expect more red days than the 25% partial gave you. Max drawdown is slightly deeper on
//     B1 (-$3,829 -> -$3,962) and C1 (-$3,978 -> -$4,298), shallower on A1.
//     TO GO BACK: untick the box; that is byte-identical to v3.9.14 behaviour.
//     Python twins flipped in the same commit (tsla_best_A/B, tsla_config_C1, config.yaml ->
//     partial_qty_pct: 0.0). faithful_be035.yaml KEEPS the 25% partial -- it is the Pine v12.4.3
//     parity config and must not move. SPCX configs also keep it (never tested all-runner there).
//
// v3.9.15 2026-08-20 - ONE TICK-BOX FOR THE ALL-RUNNER SINGLE EXIT (Profile group, default OFF).
//     "All-runner exit: take NOTHING at the target, 100% rides the runner (ONE exit)". D1 has had
//     this since v3.6 as its "D1 Exit mode"; the box generalises that one path to A1/B1/C1, so
//     there is now a single place to switch the whole suite between the 25% scale-out and a
//     one-order exit. Inert on D1 (already all-runner) and on C2 (no partial, no runner).
//     Internals: `noPartial = d1FullTrail or allRunner`, and the four sites that used to test
//     `d1FullTrail` (partial quantity, the "TRAIL ARMED" label, and the branch that places no TP
//     limit order at all) now test `noPartial`. No other logic moved; entries, stops, the BE
//     machinery, the runner exits and the reversal are untouched.
//     MEASURED 2026-08-20, Python engine, 2022-01-03..2026-08-19 @60 shares, $0.10/share slippage:
//       A1 $28,450 -> $31,664 (+11.3%) | B1 $31,507 -> $35,772 (+13.5%)
//       C1 $31,389 -> $35,754 (+13.9%) | D1 unchanged (bit-identical, which is the check that the
//       generalisation is faithful -- D1 already ran this path)
//     Past 3 years +11.7% to +12.6%; better in the 2022-23 OOS years, the 2024-25 fit window and
//     the 2026 holdout on all three profiles at once. Trade COUNT identical (quantity changes,
//     not signals). HONEST COST: win rate FALLS (B1 46.0 -> 44.3%, C1 47.5 -> 44.1%,
//     A1 46.8 -> 45.6%) since the
//     banked partial no longer rescues marginal trades; B1's day-level delta is 160 up / 185 DOWN
//     for +71.1/unit (ex-top-3 +56.7) -- more red days, bigger winners. Max DD slightly deeper on
//     B1/C1, but net-over-drawdown IMPROVES on all three (B1 8.23 -> 9.03, C1 7.89 -> 8.32,
//     A1 5.76 -> 6.62). Shipped DEFAULT OFF in v3.9.15 and turned ON in v3.9.16 once the
//     result had been read through per-year, breadth and ex-top-3.
//     NOT to be confused with exiting 100% AT the target, tested the same day and 34-42% WORSE on
//     every profile (it caps winners and leaves the BE-stop loss cohort untouched).
//
// v3.9.14 2026-08-20 - THE 11:30 ENTRY CUTOFF IS NOW HOUSE-WIDE (A1/B1/C1/C2/D1), NOT D1-ONLY.
//     v3.9.13 gave D1 an 11:30 cutoff and left everything else at 12:00, resolved per profile. The
//     same measurement has now been run on the TRADED profiles and 11:30 wins there too, so the
//     per-profile split is gone: "Entry Cutoff Hour/Minute" are plain inputs again, defaulting to
//     11:30 for EVERY profile, and "Use each profile's ADOPTED defaults" now governs the
//     Adaptive-TP multiplier ALONE.
//
//     WHY. Over 2022-01-03..2026-08-11 the 11:30-12:00 half hour is a losing cohort on the traded
//     profiles as well: B1 23 entries averaging -0.52/unit, C1 24 at -0.46, against 11:00-11:30 at
//     +0.54 and +0.50. Moving the line lifts the 2024-25 fit window, the 2022-23 out-of-sample
//     years and the 2026 holdout at the same time on every profile, and profit factor falls
//     monotonically the later the cutoff sits (B1 1.37 at 11:30 -> 1.27 with no cutoff at all).
//     Per unit: B1 500.9 -> 525.1, C1 493.3 -> 515.9, A1 446.8 -> 471.0. B1 max drawdown
//     -80.9 -> -63.8, and net per dollar of drawdown 6.19 -> 8.23.
//
//     HONEST LIMITS, recorded so nobody rediscovers them as a surprise: 2023 gets WORSE
//     (B1 -10.1/unit). Breadth is 29 affected days, 19 up and 10 down, and excluding the top 3 the
//     delta is +10.1 -- but 10:30 and 11:00 both FAIL that same ex-top-3 test, so 11:30 is a spike
//     on that column, not a plateau. Over the trailing 365 days alone it is nearly flat (+1.1% B1).
//
//     NOT CHANGED: the Adaptive-TP multiplier stays 0.75 on D1 and 1.00 on A1/B1/C1/C2. 0.75 was
//     tested on the traded profiles and REJECTED - the mechanism does not transfer. D1 exits in
//     FULL at the ATR trail, so its TP takes no money and a shorter one only ARMS the trail
//     sooner; A1/B1/C1 take a real 25% at the TP, so a shorter one caps winners too. B1 shows
//     +9.3/unit in aggregate but 314 of its 383 changed days are DOWN and ex-top-3 it is -17.9,
//     and the 2026 holdout gets worse (B1 148.5 -> 140.3, C1 158.2 -> 131.5).
//
//     Python twin: config/config.yaml + tsla_best_A/B + tsla_config_C1 move to end 11:30 (D1 was
//     already there). Trade-for-trade this is IDENTICAL to v3.9.13 on D1; A1/B1/C1/C2 simply lose
//     their 12:00-11:30 entries.
//
// v3.9.13 2026-08-20 - D1 IS NOW THE DEFAULT PROFILE, AND THE PROFILE DROPDOWN NOW CARRIES ITS OWN
//     TUNING. Two adopted changes plus the mechanism that keeps them from leaking.
//
//     1. DEFAULT PROFILE A1 -> "D1 - Adaptive + ATR-Trail (exp)" (input default only; an existing
//        chart keeps whatever it already had saved, so switch it by hand there).
//     2. NEW INPUT "Use each profile's ADOPTED defaults" (Profile group, default ON). While it is
//        ticked the Adaptive-TP multiplier and the entry-cutoff time are resolved FROM THE PROFILE
//        rather than read from their boxes:
//            D1          -> multiplier 0.75, cutoff 11:30
//            A1/B1/C1/C2 -> multiplier 1.00, cutoff 12:00   (unchanged from v3.9.12)
//        Untick it and both boxes are read exactly as typed, for whatever profile is selected.
//
//     WHY A RESOLVER AND NOT JUST NEW DEFAULTS. Python carries one config FILE per profile, so each
//     profile owns its own adaptive_tp_scale and time_window.end. Pine has ONE global input set
//     behind a dropdown. Simply moving the two defaults to D1's values would have meant that
//     switching the dropdown to B1 silently ran B1 on D1's numbers -- numbers never validated for
//     B1, and a quiet divergence from config/tsla_best_B.yaml that the TradingView reconciliation
//     would then be measuring against the wrong twin. Same idiom as the v3.9.11 symbol preset:
//     resolved once, after every input is read, so the use sites cannot drift apart.
//
//     A1/B1/C1/C2 ARE BIT-IDENTICAL TO v3.9.12. Only D1 changes, and only with the box ticked.
//
//     D1 EVIDENCE (2022-01-03..2026-08-11, per unit, full-exit D1, close-stop, $0.10 slippage):
//        multiplier 1.00 -> 0.75: net 493.6 -> 529.0 (+7.2%), PF 1.30 -> 1.33, win rate 44.9 -> 45.9,
//        max drawdown -86.3 -> -66.6 (-23%), net/drawdown +39%, POSITIVE IN ALL FIVE YEARS. Cost is
//        2024 (56.0 -> 38.9). MECHANISM: in full-exit mode the adaptive TP takes no money -- its
//        touch only ARMS the ATR trail. At 1.00x OR width the trail stayed unarmed on most trades
//        and the BE stop collected them instead; in the user's own 365-day TradingView export the
//        BE-stop family was $14,506 = 81% of ALL loss dollars at a 0% win rate, with a median
//        favourable excursion of $0.88/share, and only 14 of its 83 losers could ever have armed
//        the trail. 0.75 moves 61 trades from the BE-stop cohort to the trail cohort.
//        0.50 WAS TESTED ON REQUEST AND IS WORSE THAN 1.00 ON EVERY AXIS (2024 goes negative): the
//        cliff sits between 0.65 and 0.55, so treat 0.70-0.80 as the plateau, not 0.75 as an optimum.
//        cutoff 12:00 -> 11:30: the 11:30-12:00 cohort is 28 trades at -0.69/unit each; 11:00-11:30
//        is 40 at -0.22; 10:30-11:00 is still POSITIVE. 11:30 is the only cutoff that improves the
//        2024-25 fit window (190.7 -> 198.4), the 2022-23 out-of-sample years (149.5 -> 160.7) and
//        the 2026 holdout (188.8 -> 189.3) simultaneously. HONEST LIMIT: its net gain concentrates
//        in 2022 and is roughly FLAT over the trailing 3 years -- the case for it rests on drawdown.
//        BOTH, at 60 shares: past 3 years $22,269 -> $24,053 (+8.0%) on 21 FEWER trades, PF 1.36 ->
//        1.42, max drawdown -$3,510 -> -$3,302. Full history $29,615 -> $32,909 (+11.1%), PF 1.30 ->
//        1.36, max drawdown -$5,180 -> -$3,302, net per dollar of drawdown 5.72 -> 9.97.
//
//     TESTED AND REJECTED in the same sweep, so they are not re-proposed: the chandelier multiplier
//     2.75/3.0 (looked like a +18/unit plateau with a smaller drawdown and zero negative years over
//     25 grid cells, but its WHOLE gain is three days -- 90 days change, 36 up vs 54 down, and
//     excluding the top 3 winners the delta is -8.7); HHV/LLV period; ATR period; the hybrid-VWAP
//     variant; Max OR Width 10 (more net, worse drawdown); and Reversal Dollar-Risk Cap 8 (the
//     biggest raw number seen, +45.7/unit, and still rejected -- net/drawdown falls 7.94 -> 7.77,
//     which is leverage, and it undoes the risk-parity decision the cap exists for).
//     Python twin: config/tsla_config_D1.yaml, pinned by tests/test_params.py.
//
// v3.9.12 2026-08-19 - VERSION BUMP ONLY, so chart + alerts show matching names with the indicator.
//     THIS STRATEGY NEEDED NO CHANGE. The indicator's v3.9.12 fix adds the five named "PD Level"
//     alertcondition() rows it was missing; a strategy has no alertcondition()s -- it exits through
//     strategy.close(comment="PD Level", alert_message=f_msg(...)), so its webhook has carried the
//     PD-level exit correctly since v3.9.4. Trade-for-trade IDENTICAL to v3.9.11; do not re-run the
//     Strategy Tester on account of this version.
// v3.9.11 2026-08-12 - SYMBOL PRESET: the three TSLA-fitted gates switch off together. New input
//     "Symbol preset" in the Symbol Portability group. TSLA (the default) resolves every effective
//     value to the raw input, so the TSLA Strategy Tester result is bit-identical to v3.9.10.
//     Non-TSLA sets effRvolCap=1e9 (vol gate off), effCutOn=false (no noon cutoff) and
//     effPdxOn=false (no PD-level exit). Max OR Width is deliberately NOT included: it was tested
//     on SPCX and removing it made things worse (return down, worst trade doubled).
//     Motivation: on SPCX the 4.92% vol cap alone skipped 10 of 41 sessions including five in a
//     row at the right edge, which reads on the chart as "the strategy stopped working".
//     TOOLTIP NOTE (2026-08-13, no logic change): the preset makes non-TSLA charts work, so
//     the next move is to flip Profile and compare. On SPCX that comparison is not readable --
//     all five profiles take the identical 52 entries and paired, the best p of the ten pairs
//     is 0.166. Keep B1 for consistency with TSLA. See config/spcx_c2.yaml.
// v3.9.10 2026-08-12 — RUNS AND REPORTS ON ANY SYMBOL. No strategy logic changed; the TSLA Strategy
//     Tester result is bit-identical to v3.9.8. New group "Symbol Portability (non-TSLA charts)"
//     with a checkbox "Auto-scale $ inputs to this symbol's price" (DEFAULT OFF = production) and a
//     reference price (default 330, what the dollar defaults were fitted at).
//     THE PROBLEM. Nothing here was ever hardcoded to a ticker — every request.security uses
//     syminfo.tickerid — but every risk and target input is an absolute DOLLAR amount fitted on a
//     ~$330 TSLA. One of them is a day-level GATE: `skipWide := orWidth > maxORWidth` with
//     maxORWidth = $8. On any symbol whose first 5m bar spans more than $8, every session sets
//     daySkipped, canTrade is false all day, and the Strategy Tester reports ZERO trades with an
//     empty List of Trades. That reads as "no signals" when it is really "the gate ate the entire
//     history". The reverse breaks cheap symbols: a $2.14 minimum target is ~7% of a $30 stock and
//     never fills.
//     THE FIX. pxScale = prior daily close / reference price, applied to the eight dollar inputs:
//     maxORWidth, maxCapSL, adaptiveTPMin, atrTPMin, fixedTP, beTrailAmt, vwapArmProfit, revRiskCap.
//     Nothing else — every ratio-valued input (buffer % of OR, BE trigger % of OR, runner x OR,
//     adaptive TP multiplier, partial %, PD body/zone, rvol %) is already dimensionless and portable.
//     Prior daily close, not `close`, so the scale is fixed for the session and cannot move a stop
//     under an open position. With the box unticked pxScale is exactly 1.0 and `x * 1.0 == x`
//     bit-for-bit, so a traded number cannot move — that invariant is the point of the design.
//     NOT AN EDGE CLAIM. The frozen B1/C1 over 2024-01..2026-07 on nine liquid names (fixed $10k
//     notional, price-scaled slippage, ATR-normalisation on and off) returned 1 of 9 profitable,
//     mean -15%, all at PF 0.84-1.04 against TSLA's 1.23-1.28, and the two "winners" swapped
//     identity between variants. This makes the trades and the failures VISIBLE elsewhere; it does
//     not make them good — and the Strategy Tester still charges no commission or slippage.
//     Bonus: it also makes TSLA's own pre-2020 history readable.
//     The vol gate is intentionally left alone (already a %, so price-scale-free) — but it is still
//     TSLA-fitted at 4.92%, so watch the table's RVol row and raise it by hand if it goes red.
//     Also fixes the on-chart table title, which still read v3.9.7 on a v3.9.8 script.
//
// v3.9.8 2026-08-11 — PD-LEVEL EXIT NOW WATCHES BOTH SIDES. New input "Levels AHEAD of entry only",
//     DEFAULT UNTICKED, which drops the guard that a level must lie ahead of the entry. A level the
//     trade already broke now triggers too, so closing back through it is an exit ("you lost the
//     level"). Nothing else changed — small body, reject candle, ranking below stop / partial /
//     runner, and it still does not arm the reversal. Kept in lockstep with the indicator.
//     ADOPTED BY USER CALL AGAINST THE MEASUREMENT — per unit 2022-01-03..2026-08-10, unticked vs
//     ticked: A1 485.6/502.0, B1 558.3/575.9, C1 556.4/573.2, D1 480.3/483.5. B1 by year: 2022 -21.2
//     / 2023 -5.1 / 2024 -4.8 / 2025 -3.4 / 2026 +17.0; win rate 46.2->44.2%. Four of five years are
//     worse and 2026 — the only year that gains — is the only year the motivating days came from.
//     Tick the box to revert. Tag zone stays 0.05. See docs/BE_STOP_ANALYSIS.md §32d.
//
// v3.9.7 2026-08-11 — HALF-DAY SESSIONS NOW FLATTEN ON THEIR OWN LAST BAR. One line of session logic;
//     no profile, entry, exit or PD-level behaviour touched. Found by reading the v3.9.6 trade list
//     rather than the summary numbers: `session.islastbar_regular` was meant to cover the early close
//     and does not fire on TSLA's 12:55 final bar, so the day-after-Thanksgiving sessions issued no
//     EOD close, `isNewDay` then reset `active`, and the orphaned position was flattened a full
//     session later by the "EOD flat" safety net — 2012-11-23 and 2018-11-23 on all four profiles,
//     2017-11-24 on C1. The 2018 one is a -$121.20 short carried through a three-day weekend.
//     The session end now comes from the daily bar (`time_close("D")` = 13:00 on an early close,
//     16:00 otherwise), so the flatten lands on the genuine last bar and, with
//     process_orders_on_close, fills at that bar's close — exactly orb_engine.py's `last_ts_by_date`.
//     FULL SESSIONS ARE TRADE-FOR-TRADE UNCHANGED: on a normal day the new condition is the 15:55
//     bar, which the 15:50 EOD rule had already claimed. Only ~3 sessions in 14 years differ.
//
// v3.9.6 2026-08-10 — THE PD-LEVEL TAG-AND-REJECT EXIT IS NOW ON BY DEFAULT (`pdxOn` false -> true).
//     ONE INPUT DEFAULT CHANGED, no logic edited. The rule itself, its ranking below the stop / target /
//     partial / runner, and its refusal to arm the reversal are all exactly as shipped in v3.9.4.
//     WHY: measured here, on C1, over 2025-08-11..2026-08-10, by exporting the SAME script twice — once
//     with the box ticked and once without. The two exports are otherwise trade-for-trade identical
//     (260 of 260 entries match to the cent), so the delta IS the rule and nothing else:
//         ON  $17,554   PF 1.76   win rate 55.2%   (361 legs / 260 trades)
//         OFF $13,623   PF 1.52   win rate 50.4%   (372 legs / 261 trades)
//     = +$3,932 (+29%), worst single trade unchanged, positive in both year-cells (2025 +$1,786 /
//     2026 +$2,145). The 54 fires are right 38 times (70%): they save $6,195 and give up $2,530, and one
//     of them pays twice — 2025-09-10 cut a primary at -$18 instead of a -$154 BE Stop, and because a
//     PD-Level exit does NOT arm the reversal it also skipped the -$266 reversal that followed. That is
//     also why the OFF run has MORE trades: turning the rule off lets a suppressed reversal back in.
//     CAVEAT, unchanged: the 0.25 body threshold was fitted in-sample on this same span with NO holdout,
//     the plateau is flat rather than peaked (the old note that D1 preferred 0.15 did not survive a full
//     sweep — see the knob's tooltip), and the Strategy Tester charges zero commission
//     and zero slippage (haircut ~12-15%). Untick the input to get the v3.9.3 baseline back.
//
// v3.9.5 2026-08-10 — THE OR / TRIGGER LINES NOW BEHAVE LIKE THE PD LINES. DRAWING ONLY: no entry, exit,
//     stop, target, reversal, day-skip, order or webhook rule changed, so the Strategy Tester result is
//     trade-for-trade IDENTICAL to v3.9.4 (itself identical to v3.9.3 with the experimental exit left OFF).
//     OR High / OR Low / Long Trigger / Short Trigger were plot(style_linebr) — one continuous series that
//     TradingView joins from the last bar of one session to the first bar of the next, so on a multi-day
//     chart yesterday's aqua/lime/red levels ran on into today. They are now four LINE OBJECTS per session:
//     opened on that day's OR bar, extended only to that day's own bars, then never touched again. Each
//     carries a small right-end tag ("OR H 331.20", "OR L 328.40", "LONG > 331.55", "SHORT < 328.05") so
//     no legend is needed. Triggers are DASHED to separate them from the solid OR boundaries at a glance.
//     History is bounded by "Days of OR / trigger segments to keep" (default 10), the same guard the PD
//     segments use, so the 500-line / 500-label caps stay safe on a 365-day run. Skipped days (vol /
//     wide-OR) draw nothing, exactly as before.
//
//     ALSO IN v3.9.5 — THE CHART STATUS LINE IS NOW READABLE. TradingView echoes every input value after
//     the script name, which on this script was a ~40-number wall ("... 15 50 09:30 12 0 8 20 4.92 10 1 60
//     0 1 2.14 0.25 1 14 2 0.55 ..." running off the right edge). Every input now carries
//     `display=display.none` EXCEPT `profile`, so the status line reads just
//         UDB-ORB v3.9.7 S   A1 - Adaptive + Peak-Trail
//     The inputs themselves are UNCHANGED — same names, defaults, groups and tooltips in the settings
//     dialog; only their on-chart echo is suppressed. Nothing an order or an `alert_message` reads is
//     touched, so the Strategy Tester and every webhook payload are byte-identical. The stats table stays
//     the place to read live values. Zero-code equivalent if you ever want them back on one chart: Chart
//     settings -> Status line -> "Indicator arguments".
//
// v3.9.4 2026-08-10 — TWO CHANGES, both to the prior-day-level feature added in v3.9.3.
//
// (1) THE LINES ARE NOW ONE SEGMENT PER DAY. v3.9.3 drew them with plot(style_stepline), which runs the
//     full chart width and puts a vertical riser at every session boundary, so yesterday's level bled
//     into today. Each session now gets its own four line objects, opened on its first RTH bar and
//     extended only to its own last bar. A small self-identifying tag ("PDH 331.20") rides just ABOVE
//     the RIGHT END of each segment. History is bounded by "Days of prior-day segments to keep"
//     (default 10); older sessions are deleted, so the trade labels keep their share of the 500-object
//     caps. PURELY COSMETIC — no order, entry, exit or webhook JSON is touched by it.
//
// (2) NEW OPTIONAL EXIT: "PD-level tag-and-reject" — DEFAULT OFF, so out of the box the Strategy Tester
//     result is byte-identical to v3.9.3. When enabled, the position is flattened at the close of a bar
//     that (a) tags a prior-day level lying AHEAD of the trade, (b) closes rejected back off it, and
//     (c) has a SMALL BODY (|close-open| / (high-low) < the threshold). It is ranked BELOW the stop, the
//     target/partial and the runner exits, and it does NOT arm the reversal — matching orb_engine.py.
//     The body filter is the entire result: unfiltered the rule loses $3,796-$5,466 over 5 years on
//     every profile; at body<0.25 it is +$1,248 A1 / +$2,983 B1 (5/5 years) / +$3,487 C1 (5/5 years) /
//     +$755 D1. A doji or pin that cannot close through the level is the signal; a big decisive candle
//     at the level is a trend bar and price continues.
//     NOT ADOPTED — threshold picked in-sample over all 5 years with no holdout, optimum is
//     profile-dependent, effect dead by 0.35. Forward-validate first. See docs/BE_STOP_ANALYSIS.md S32c.
//
// v3.9.3 2026-08-09 — PRIOR-DAY LEVELS (PDH / PDL / PDC / PDO) ADDED, DIAGNOSTIC ONLY.
// Four new plots + an input group "Prior-Day Levels". NO order, entry, exit, stop, target, reversal,
// day-skip or webhook JSON reads them — the Strategy Tester result is byte-identical to v3.9.2.
// Purpose: eyeball whether ORB failures (BE stops especially — 87% of losses) cluster at a prior-day
// level, ahead of deciding whether any of them is worth turning into a real filter.
// LEGEND — four different colours AND four different patterns, so each is identifiable in a screenshot:
//     PDH = MAGENTA / fuchsia, thick SOLID step line     (prior day HIGH)
//     PDL = BLUE  #2962FF,     thick SOLID step line     (prior day LOW)
//     PDC = WHITE,             thin DOTTED (circles)     (prior day CLOSE)
//     PDO = ORANGE,            thin CROSS / x marks      (prior day OPEN)
// Right-edge tags re-use 4 label objects (moved, never re-created), so they are safe to leave on even
// with "Show Labels" OFF for a 365-day run — they cost 4 of the 500-label budget, permanently.
// PRIOR ART: the Python enhancement `pdh_pdl_filter` is BUILT and default OFF — it barely triggers on
// TSLA (docs/BE_STOP_ANALYSIS.md sect.6). PDC and PDO have never been tested in any form.
// Keep this file's version EQUAL to the indicator's — both moved to v3.9.3 together.
//
// v3.9.2 2026-08-09 — TWO DEFAULTS CHANGED (no logic change; both are input defaults only):
//   1. "Option expiration" +0 days -> "Friday (weekly)".  2. "Profile" C1 -> A1.
// WHY (options expiry audit, 2026-08-09, from the OPRA definition files themselves):
//   TSLA listed FRIDAY-ONLY expiries until 2026-02-02 (first Mon/Wed contract appeared in the
//   2026-01-26 snapshot). Cached definitions: 2025 = 49 Fri + 2 Thu (holiday weeks) and ZERO
//   Mon/Wed; 2026 = 24 Mon / 23 Wed / 36 Fri. So every options figure published for the
//   2025-01..2026-07 window was priced ~85% on FRIDAY contracts at 1-4 DTE — the "0DTE" label
//   on those numbers is a misnomer, and the old "weekly beats 0DTE by 3-5%" claim was comparing
//   a contract to ITSELF over most of the sample (tell-tale: D1 2025 dte0 +$3,560 vs wk +$3,570).
//   With 2026 data the two legs are finally distinct, and WEEKLY wins on 5 of 5 profiles in each
//   of 3 independent windows (2026 Jan-May, Jun-Jul17, and the forward ledger's 70 true-0DTE
//   trades, ~30% less loss there). "Friday (weekly)" also ALWAYS resolves to a listed contract on
//   any weekday; "+0 days" silently rolls to 1DTE on Tue/Thu because TSLA has no dailies.
//   PROFILE -> A1: best on options in BOTH priced windows and the only profile positive in the
//   flat Jan-May stretch. NOTE B1 is the WORST on options (-$1,116 Jan-May) though it is a
//   traded shares profile — the shares ranking and the options ranking are NOT the same.
// SIZE FOR THIS: the 2026 options edge is REGIME-CONCENTRATED, not a steady drip. Weekly, 1 ct,
//   barclose: Jan 2-May 31 (109 trades, 5 months) A1 +$785 / D1 +$462 / C1 -$316 / C2 -$387 /
//   B1 -$1,116 — i.e. the best profile made ~$7/trade on ~$656 of premium, indistinguishable
//   from zero. Jun 1-Jul 17 (34 trades) A1 +$7,743 (June alone +$6,635). 91% of 2026's options
//   P&L came from 34 of 143 trades, and the window after it (forward test) is negative.
//
// v3.9.1 2026-07-28 — DOCUMENTATION ONLY (no logic, no input, no order, no webhook change).
// Records a concept tested and REJECTED 2026-07-28, so it is not re-proposed from the chart:
// IMMEDIATE REVERSAL ON THE BE-STOP BAR — flip at the same 5m close the BE stop fills at, instead
// of waiting for a close back through the raw opposite OR boundary (the current rule). Asked from
// a live chart where the flip would have worked; built as the Python enhancement
// reversal_capture.immediate_on_be_stop (default OFF) and swept on ALL FIVE profiles.
// It roughly DOUBLES the reversal count (198 -> 374 over 5yr) while total reversal P&L FALLS
// (+145.6 -> +79.8/unit) — the ~176 extra flips are collectively net-negative. The best variant
// beat baseline on 2024-2026 WINDOW TOTALS in every profile (A1 +17.6, B1 +17.6, C1 +5.7,
// C2 +28.0, D1 +23.4) — but per YEAR it loses 2022, 2023 AND 2024 in every profile:
//   delta/unit vs base, sum of A1+B1+C1+C2+D1:
//   2022 -78.8 | 2023 -151.7 | 2024 -56.0 | 2025 +109.5 | 2026YTD +38.9   (2022-23 = true OOS)
// The whole "edge" is 2025. Trailing 2 months negative in all five (A1/B1/D1 -2.8, C1 -3.5,
// C2 -0.2); D1's 5yr maxDD degrades -56.1 -> -66.6. Same 2025-only regime signature that killed
// the midline-trigger reversal. Profile choice cannot rescue it: all five share ONE entry engine
// and differ only in the runner exit, so the flip lands on the identical set of BE-stop bars.
// DO NOT RE-ADD. The OR-break wait is a FILTER, not latency — crossing the whole range is what
// distinguishes a genuine failed breakout from chop INSIDE the range, and the reversal's own stop
// is only meaningful once price has crossed it. (Structural note: a BE-stop fill often lands
// inside/below the OR, which would put the normal reversal stop on the WRONG side of entry and
// let the risk-parity cap inflate size absurdly.)
// Reproduce: python scripts/immediate_reversal_test.py --profiles all --years [--windows|--detail]
// Full analysis: docs/BE_STOP_ANALYSIS.md §31.
// v3.9 2026-07-26 — ENTRY CUTOFF ADOPTED (default ON, 12:00): loss-anatomy on 5 years of trades
// showed post-noon entries are a net-NEGATIVE cohort (the 12:00-13:00 lunch hour is the toxic
// pocket; losing stops die in ~30min while winners run for hours). No NEW entries — primary or
// reversal — after 12:00; open positions still manage to their normal exits. Verified on
// A1/B1/C1/D1 incl 2022-23 OOS: WR up in every tested year-cell, net +3-4% (B1 5yr +463.4 vs
// +450.7/unit), worst day never worse (2025's improves). Python twin: enhancements.time_window
// {start 09:35, end 12:00} enabled in the A1/B1/C1/D1 + default yamls. Same-day knob re-sweep:
// stop cap $5, BE trigger 0.55, BE trail $0.25 all confirmed optimal.
// v3.8 2026-07-25 — OPTION QUANTITY MODE (enables the +49-63% fixed-DOLLAR sizing finding): new
// "Option quantity mode" input. "Fixed contracts" (default) = unchanged. "TradersPost sizing" =
// the options entry JSON OMITS the quantity field so TradersPost's strategy-level position sizing
// ("Amount per position" ~$1,100 + max-qty cap ~4) computes contracts from the premium — the
// 2026-07 analysis: fixed-$ sizing beat fixed 2ct by +49-63% (A1 +$42,093 vs +$25,790) with lower
// premium at risk. VERIFY IN PAPER first that TradersPost divides by the option PREMIUM for
// options (docs don't say); exits unaffected. Mid-price ENTRY LIMITS were fill-simulated same day
// and REFUTED (adverse selection: missed winners > all spread savings) — entries stay MARKET.
// v3.7 2026-07-24 — CONFIGURABLE SHARE QUANTITY (user request, mirrors the Option-contracts input):
// the "Shares per 'unit'" input is RENAMED "Share quantity (Shares mode, per 1.0-unit trade)" —
// set your fixed share size there once; every order and webhook JSON quantity = Units Per Trade x
// this (default 1.0 x 25 = 25 sh; the risk-parity reversal scales off it and may exceed it up to
// the $-risk cap). Same-named input added to the v3.7 INDICATOR (its entry/reversal/partial alerts
// now carry the exact share count; table adds a "Net @ N sh" dollar row) — keep the two inputs
// EQUAL. No trade-logic change; sizing default (25) unchanged.
// v3.6 2026-07-23 — D1 EXIT MODE OPTION (user request, like the C2 formula input): new "D1 Exit
// mode" input — "Partial TP + ATR Trail" (default, the original D1) vs "FULL EXIT AT ATR TRAIL":
// nothing is taken at the adaptive TP (its touch only ARMS the trail; no TP order is placed),
// 100% exits on the TRADE TASTIC flip — ONE exit alert/order, so it also suits platforms that
// cannot split exits. Tested (per unit, fixed trail, close-stop) full-trail vs partial:
// 2024 +39.7 vs +38.4 | 2025 +85.2 vs +72.2 | 2026YTD +179.0 vs +162.3 -> full-trail wins ALL
// THREE (3yr +304 vs +273; B1 ref +268), 2025 worst day -13.6 vs -12.0, ~1pt lower WR.
// Python twin: tsla_config_D1.yaml with partial_qty_pct: 0.0.
// v3.5 2026-07-23 — C2 TAKE-PROFIT FORMULA CHANGED (user request): C2's target is now the OPEN
// BAR's High - Low (= OR width, no floor/scale) instead of the fixed $2. Per unit, close-stop,
// OR-width vs fixed-$2: 2022 +29.7 vs +42.9 | 2023 +82.3 vs +88.8 | 2024 +36.6 vs -23.1 |
// 2025 +38.3 vs -0.3 | 2026YTD +111.7 vs +49.0  => 5yr +298.6 vs +157.3 (~2x), POSITIVE EVERY
// YEAR (the fixed $2 was net-NEGATIVE 2024 and flat 2025 under the close stop). WR drops
// (46-50% vs 50-63%). The old behavior stays selectable: "C2 Take-Profit formula" = Fixed $.
// v3.4 2026-07-23 — D1 SHORT-SIDE FIX (user-caught same day on the live chart): the original
// TRADE TASTIC script has ONE line — a SHORT must exit on the red->green flip of the SAME
// HHV(high - mult*ATR) line, not on an invented mirrored LLV(low + mult*ATR) line. On 2026-07-23's
// short the true flip was 10:35 (close 324.30 > TS 319.48); the mirror exited 11:55. Fixed here,
// in the v3.4 indicator, and in the Python engine (single-line everywhere; longs unchanged).
// CORRECTED numbers, per unit, D1 vs B1: 2024 +38.4 vs +20.2 | 2025 +72.2 vs +102.8 |
// 2026YTD +153.9 vs +138.0 -> 3yr ~tie (+264 vs +261). Still experimental / NOT adopted.
// v3.3 2026-07-23 — NEW PROFILE D1 (experimental, for side-by-side comparison — NOT adopted):
// D1 = B1's engine (Adaptive TP + 25% partial) with the "TRADE TASTIC" ATR TRAIL as the runner
// exit instead of the VWAP cross. Python twin: config/tsla_config_D1.yaml (atr_trail_exit).
// (v3.3's short side + numbers were the buggy mirror — superseded by the v3.4 fix above.)

// v3.2 2026-07-23 — PARTIAL-AS-ORDER OPTION (no trade-logic change): new Shares-mode input "Partial exit
// as opposite-side order". Some execution platforms treat action=exit as FLATTEN-ALL and ignore the
// quantity, so the 25% partial's '{"action":"Exit","quantity":N}' closed the whole position. ON sends the
// partial as a plain opposite-side order instead — long -> '{"action":"Sell","quantity":N}', short ->
// '{"action":"Buy","quantity":N}' — so a netting platform reduces the position by N. The runner / stop /
// VWAP / EOD exits still send full "Exit". REQUIRES a platform that NETS an opposite-side order against
// the open position (reduces); if yours REVERSES (closes all + opens the other way), leave this OFF.
// Verify one partial fill in paper before trusting it live. Default OFF (TradersPost exit honors quantity).
// v3.1 2026-07-21 — OPTIONS ALERT FIX (no trade-logic change): in Options mode the 25% partial's
// suppressed webhook used alert_message=na, so TradingView fired the fill alert with the LITERAL text
// "{{strategy.order.alert_message}}" (an unset alert_message leaves the placeholder unresolved — seen
// live on the B1 Options alert 2026-07-21 10:45, the Partial@TP fill). It now sends an explicit
// human-readable "no action" text that TradersPost ignores; every order now carries an alert_message.
// STATUS 2026-07-19 — CORRECTED 2026-07-24: the rival "3-bot" concept's TSLA result (+$45,916 @1ct)
// was ENTIRELY the bar-START pricing lookahead; barclose-corrected it is NEGATIVE on TSLA (BOT1
// -$2,295 @1ct 2022-26, all spread bots negative) — UDB stays the TSLA system, now unambiguously.
// TSLA credit spreads tested and rejected (thin credits vs $2.50 strikes, weekly expiry). Every weekday is
// net-positive; FRIDAY is the best options day (74% WR, true 0DTE) — never skip it. Options paper trading:
// per-contract risk ~= HALF the premium (median ~$435/ct); prefer fixed-DOLLAR sizing over fixed contracts
// (cheap-premium entries carry PF ~6 vs ~2.5 on rich ones). SPX system = SEPARATE SPX_ORB_3BOT_v1 files;
// both forward ledgers (TSLA forward_test.py + SPX forward_test_spx.py) run daily via the 9AM task.
// STATUS 2026-07-14: ONE strategy, FOUR selectable profiles (the "Profile" input). TSLA 5-minute, RTH,
// OR start 09:30 (selectable). DEFAULT = $10,000 account, 25 shares/unit (~1x unleveraged on TSLA). All
// share the SAME entry engine, ADOPTED close-triggered stops (Stop trigger 'Close'), vol/OR gates, risk-parity
// reversal, confirmation OFF. They differ ONLY in the exit:
//   A1 = Adaptive TP + 25% partial + PEAK-TRAIL runner        (Max Stop $5)
//   B1 = Adaptive TP + 25% partial + VWAP-CROSS runner        (Max Stop $5)
//   C1 = ATR-target (0.25 x 14d ATR) + 25% partial + VWAP     (Max Stop $6)   <- best PF
//   C2 = OR-WIDTH target (open bar H-L), FULL exit (no partial/runner) (Max Stop $5) [was fixed $2 pre-v3.5]
//
//  EXECUTION MODEL — proper OCO brackets (all fills intrabar at the level / open-on-gap = touch):
//   * C2 (full exit): ONE strategy.exit("X", stop=, limit=) — whole position at stop OR target.
//   * A1/B1/C1 (partial+runner): "P1" = the 25% partial as an OCO(stop+target), "RUN" = the 75%
//     remainder on the stop (peak-trail A1 / VWAP-close B1,C1). BOTH legs carry a stop, so a stop-out
//     closes 100% (the earlier bug let a limit-only leg ride to EOD). Reversal arms only on a stop-out
//     before any partial (state part1/tpWasHit). See BE_STOP_ANALYSIS + memory (2026-07-13 TV fix).
//
//  SHARES PER UNIT (default 25 = ~$10k on TSLA): the reversal is risk-parity sized and needs FRACTIONAL
//  units (e.g. 1.59); at 1 share/unit that rounds to 1 and the cap vanishes. With 25, 1.59 units = ~40 sh.
//  ==> Strategy Tester P&L = 25x the Python per-unit figures (= the @100-share reports / 4). The 2x
//  reversal can momentarily hold ~2x notional; margin_long/short are left 0 so it isn't rejected on $10k.
//
//  DEFAULT $10,000 / 25-SHARE RESULTS (FULL 2022-2026, ADOPTED close-triggered stop = Stop trigger 'Close'):
//    Profile   Net$      %ret   PF    WR    MaxDD$   %DD    WorstDay      (Strategy Tester = per-unit x25)
//    A1        +10,817   +108%  1.22  48%   -1,562   -16%   -300
//    B1        +11,258   +113%  1.23  47%   -1,856   -19%   -300         (max net)   <- USER TRADES B1
//    C1        +10,371   +104%  1.22  48%   -1,937   -19%   -332         (best PF/DD balance) <- and C1
//    C2        +4,383    +44%   1.12  57%   -1,673   -17%   -300         (high WR, lowest net; drives OPTIONS)
//  ADOPTED 2026-07-14 - STOP fires only when the bar CLOSES beyond the level (default 'Close'): +42-46% net
//    vs the old wick/resting stop, ~40% smaller drawdown, and 2024 FLIPS from a loss to a profit. The TP
//    still fills on a favorable wick. Walk-forward OOS-confirmed: 2022 & 2023 (never part of discovery)
//    both +$3.4-5.9k @100. Flip Stop trigger -> 'Wick' for the OLD any-touch resting stop (then beRealistic).
//  RECONCILE: Strategy Tester net = Python per-unit x 25  (= the @100-share validation reports / 4).
//  A stop-exit (Base SL / BE Stop / BE Trail) MUST appear in every profile & cap near Max Stop ($5/$6).
//  Size off 2024 (was a losing year, now marginally green), NEVER off the flattering 2026.
//  READ: B1 = raw-net leader, C1 = near-equal net with the best PF/DD balance. Both are what the user trades.
//  A1 = dominated by B1/C1. C2's 57% WR is a mirage (lowest net, WORST drawdown, most losing months -
//  it caps winners at $2 but still eats full stops). Every profile is positive in all 5 years.
//=============================================================================================

// ==================== PROFILE ====================
profile = input.string("D1 · Adaptive + ATR-Trail (exp)", "Profile",
     options=["A1 · Adaptive + Peak-Trail", "B1 · Adaptive + VWAP", "C1 · ATR 0.25 + 25% Partial + VWAP", "C2 · OR-Width Full-Exit", "D1 · Adaptive + ATR-Trail (exp)"],
     group="Profile", tooltip="A1/B1 = adaptive OR-scaled target + 25% partial + runner (peak-trail vs VWAP). C1 = ATR-sized target + 25% partial + VWAP (best PF). C2 = full exit at OR-WIDTH target (open bar H-L; was fixed $2 pre-v3.5), no partial/runner. D1 (EXPERIMENTAL, not adopted) = B1 with the TRADE TASTIC ATR trail as the runner exit.")
c2TPFormula = input.string("OR width (open bar High-Low)", "C2 Take-Profit formula", options=["OR width (open bar High-Low)", "Fixed $"], group="Profile", tooltip="ADOPTED v3.5 (default): C2's target = the OPEN BAR's High - Low (= OR width, no floor). vs the old fixed $2 (per unit, close-stop): 2024 +36.6 vs -23.1, 2025 +38.3 vs -0.3, 2026YTD +111.7 vs +49.0; 2022/23 slightly behind; 5yr ~2x and positive every year. 'Fixed $' = the pre-v3.5 C2 (uses the Fixed TP $ input).", display=display.none)
d1ExitMode = input.string("Full exit at ATR Trail", "D1 Exit mode", options=["Full exit at ATR Trail", "Partial TP + ATR Trail"], group="Profile", tooltip="D1 only. 'Full exit at ATR Trail' (DEFAULT since 2026-07-23; the Python forward test tracks it) = NOTHING is taken at the TP — its touch only ARMS the trail; 100% exits on the flip (ONE exit alert/order — also suits platforms that cannot split exits). 'Partial TP + ATR Trail' = the original D1: 25% off at the adaptive TP, 75% rides the flip. v3.6 test (per unit, fixed trail): full-trail beats the partial in all of 2024/25/26 (+39.7/+85.2/+179.0 vs +38.4/+72.2/+162.3) at a slightly deeper 2025 worst day (-13.6 vs -12.0).", display=display.none)
profDefaults = input.bool(true, "Use each profile's ADOPTED Adaptive-TP multiplier", group="Profile", tooltip="TICKED (default) = the \"Adaptive TP - OR Width Multiplier (manual)\" box is IGNORED and each profile gets the multiplier it was actually validated at:\n  D1 -> 0.75\n  A1/B1/C1/C2 -> 1.00\n\nWHY THIS EXISTS. The Python side carries one config FILE per profile, so each profile owns its own adaptive_tp_scale. Pine has ONE global input set behind a Profile dropdown, so a single box cannot serve five profiles -- and before v3.9.13 switching the dropdown to B1 silently kept D1's 0.75, which is not B1's validated number. Ticking this makes the dropdown carry its own setting, the way the config files do, and keeps every profile reconciling to its Python twin.\n\nWHAT D1's 0.75 BUYS (2022-01-03..2026-08-11, per unit, full-exit D1): net 493.6 -> 529.0, PF 1.30 -> 1.33, win rate 44.9 -> 45.9, max drawdown -86.3 -> -66.6, positive in all five years. In full-exit mode the adaptive TP takes no money -- its touch only ARMS the ATR trail -- so a target at 1.00x OR width left the trail unarmed on most trades and the BE stop (81% of all loss dollars at a 0% win rate) collected them instead. 0.50 was tested too and is WORSE than 1.00 on every axis (2024 turns negative): the cliff sits between 0.65 and 0.55, so 0.70-0.80 is the plateau.\n\nWHY A1/B1/C1/C2 STAY AT 1.00. 0.75 was tested on them on 2026-08-20 and REJECTED. They take a real 25% partial at the TP, so shortening it caps winners as well as arming exits sooner. B1 shows +9.3/unit in aggregate but 314 of its 383 changed days are DOWN and ex-top-3 the delta is -17.9; the 2026 holdout gets worse on both traded profiles.\n\nUNTICK to hand-tune: the multiplier box is then read exactly as typed, for whatever profile is selected.", display=display.none)
allRunner = input.bool(true, "All-runner exit: take NOTHING at the target, 100% rides the runner (ONE exit)", group="Profile", tooltip="TICKED (DEFAULT since v3.9.16) = ALL-RUNNER: NOTHING is taken at the adaptive target -- its touch only ARMS the runner -- and 100% of the position leaves on ONE exit. UNTICK to get the old scale-out back: A1/B1/C1 then take the \"Partial Exit Quantity %\" (25%) off at the target and the remaining 75% rides the runner (A1 peak-trail, B1/C1 VWAP cross), which is byte-identical to v3.9.14. This is exactly what D1 already does by default (see \"D1 Exit mode\"), so on D1 this box changes nothing, and on C2 it is inert (C2 has no partial and no runner).\n\nWHY YOU MIGHT WANT IT: one exit order instead of two -- no scale-out, no partial fill for the broker to net, no \"Partial\" alert.\n\nMEASURED 2026-08-20 (Python engine, 2022-01-03..2026-08-19, 60 shares, after $0.10/share slippage):\n  A1  $28,450 -> $31,664  (+11.3%)\n  B1  $31,507 -> $35,772  (+13.5%)\n  C1  $31,389 -> $35,754  (+13.9%)\n  D1  unchanged -- already all-runner\nPast 3 years: A1 +12.3%, B1 +11.7%, C1 +12.6%. It improves the 2022-23 out-of-sample years, the 2024-25 fit window AND the 2026 holdout on all three profiles. The TRADE COUNT is identical (1,098 / 1,100 / 1,099 over the full history): this changes exit QUANTITY, never entries or exit timing.\n\nWHAT IT COSTS: the win rate FALLS (B1 46.0 -> 44.3%, C1 47.5 -> 44.1%, A1 46.8 -> 45.6%) because the small banked partial no longer rescues a trade into the green; the average winner grows instead (B1 $4.19 -> $4.54/share). Day by day on B1 the delta is 160 days UP against 185 DOWN and still +71.1/unit in total (ex-top-3 +56.7) -- the gain is magnitude, not frequency, so expect MORE red days than you have now. Max drawdown is slightly deeper on B1 (-$3,829 -> -$3,962) and C1 (-$3,978 -> -$4,298), shallower on A1 (-$4,943 -> -$4,781); net/DD IMPROVES on all three (B1 8.23 -> 9.03, C1 7.89 -> 8.32, A1 5.76 -> 6.62).\n\nNOT the same thing as exiting 100% AT THE TARGET. That was tested the same day and is 34-42% WORSE on all four profiles: it caps the winners while leaving the BE-stop loss cohort (87% of all loss dollars) completely untouched.\n\nADOPTED as the default on 2026-08-20 together with the Python twins (tsla_best_A/B, tsla_config_C1 and config.yaml now carry partial_qty_pct: 0.0). The Pine v12.4.3 parity config faithful_be035.yaml deliberately KEEPS the 25% partial, and so do the SPCX configs -- all-runner was never tested on SPCX.", display=display.none)
isA1 = str.startswith(profile, "A1")
isB1 = str.startswith(profile, "B1")
isC1 = str.startswith(profile, "C1")
isC2 = str.startswith(profile, "C2")
isD1 = str.startswith(profile, "D1")
tpModeSel  = isC2 ? (str.startswith(c2TPFormula, "Fixed") ? "Fixed" : "ORw") : isC1 ? "ATR" : "Adaptive"
d1FullTrail = isD1 and str.startswith(d1ExitMode, "Full")   // D1 full-trail: TP touch only arms; 100% exits on the flip
// v3.9.15: the ONE switch for a single-exit workflow. D1's full-trail path,
// generalised -- nothing off at the target, 100% leaves at the runner exit.
noPartial = d1FullTrail or allRunner
usePartial = not isC2                 // C2 is a full exit; A1/B1/C1/D1 scale out 25% (D1 full-trail: 0%)
runnerVWAP = isB1 or isC1             // true = VWAP-cross runner ; false = peak-trail (A1) or ATR trail (D1)

// ==================== INPUTS ====================
grpS = "Session"
eodHour = input.int(15, "EOD Exit Hour", minval=0, maxval=23, group=grpS, display=display.none)
eodMin  = input.int(50, "EOD Exit Minute", minval=0, maxval=59, group=grpS, display=display.none)
orStart = input.string("09:30", "Opening Range start bar", options=["09:30", "09:45"], group=grpS, tooltip="09:30 = classic first-bar OR. 09:45 = skip the noisy opening 15 min (better 2024/25 backtest, WORSE 2026).", display=display.none)
entryCutOn = input.bool(true, "Entry cutoff — no NEW entries after the time below", group=grpS, tooltip="ADOPTED 2026-07-26 (default ON; TIGHTENED to 11:30 on 2026-08-20, v3.9.14): entries late in the morning were a net-NEGATIVE cohort in 5 years of trade data — the damage concentrates in the 12:00-13:00 lunch hour. Blocking NEW entries (primary AND reversal; open positions still manage to their normal exits) after 12:00: WR up in all 7 tested year-cells on B1/D1 (+A1/C1 confirmed), net +3-4% (B1 5yr +463 vs +451/unit), worst day never worse, 2025's improves. OFF = trade all day (pre-cutoff behavior).", display=display.none)
entryCutH  = input.int(11, "Entry Cutoff Hour", minval=9, maxval=15, group=grpS, tooltip="No NEW entries (primary or reversal) after this time; an open position still manages to its own normal exits. ADOPTED 11:30 house-wide on 2026-08-20 (v3.9.14) -- the 11:30-12:00 half hour is a losing cohort on every profile (B1 -0.52/unit average, C1 -0.46, against +0.54/+0.50 for 11:00-11:30), and moving the line lifts the fit window, the out-of-sample years and the holdout at once. The tick-box above still switches the cutoff off entirely.", display=display.none)
entryCutM  = input.int(30, "Entry Cutoff Minute", minval=0, maxval=59, group=grpS, display=display.none)

grpR = "Risk / Regime Gates"
maxORWidth  = input.float(8.0,  "Max OR Width ($) — skip wider days", step=0.5, group=grpR, display=display.none)
volLookback = input.int(20,     "Volatility Lookback (days)", minval=2, group=grpR, display=display.none)
maxRvolPct  = input.float(4.92, "Max Prior Realised Daily Vol (%)", step=0.01, group=grpR, display=display.none)

grpSYM = "Symbol Portability (non-TSLA charts)"
pxAutoOn = input.bool(false, "Auto-scale $ inputs to this symbol's price", group=grpSYM, tooltip="OFF BY DEFAULT AND OFF IS THE PRODUCTION SETTING -- with this unticked pxScale is exactly 1.0, every parameter multiplies by 1.0, and the Strategy Tester result is bit-identical to v3.9.8 on TSLA. Nothing about the strategy changes.\n\nWHY IT EXISTS. Every risk and target input here is an absolute DOLLAR amount fitted on a ~$330 TSLA. Nothing is hardcoded to the ticker (all data requests use syminfo.tickerid), but the dollar scale is. The one that bites is 'Max OR Width ($)' = 8: it is a day-level gate, so on any symbol whose first 5-minute bar spans more than $8 EVERY session is skipped, the Strategy Tester reports ZERO trades, and the List of Trades is empty -- indistinguishable from 'no signals'. That is the usual reason this looks dead on another symbol.\n\nWHAT IT DOES. Multiplies the eight dollar-denominated inputs by (prior daily close / reference price). Purely a units conversion -- no rule, threshold ratio, or sequence is altered.\n\nWHAT IT IS NOT. Not a way to make this profitable elsewhere. The frozen B1/C1 was tested over 2024-01..2026-07 on nine liquid names at fixed $10k notional with price-scaled slippage, with and without ATR normalisation: 1 of 9 profitable, mean -15%, every non-TSLA symbol at PF 0.84-1.04 (breakeven noise) against TSLA's 1.23-1.28, and the two 'winners' swapped identity between the two variants. Use this to SEE the trades and the failures on another chart, not to trade them. Remember the Strategy Tester also charges no commission or slippage.\n\nSide effect worth knowing: it also makes TSLA's own pre-2020 history readable, where a $2.14 minimum target against a $5-20 share price otherwise makes every year meaningless.", display=display.none)
pxRef    = input.float(330.0, "Reference price ($) the $ defaults were tuned at", minval=0.01, step=1.0, group=grpSYM, tooltip="The share price the dollar defaults were calibrated at. TSLA sat near $330 when Max OR Width $8 / Adaptive TP floor $2.14 / BE trail $0.25 / max stop $5-6 were fitted, so 330 is the correct reference and you should not need to change it. Scale factor = prior daily close / this. Only read when the box above is ticked.", display=display.none)
symPreset = input.string("TSLA (as validated)", "Symbol preset", options=["TSLA (as validated)", "Non-TSLA - TSLA-fitted gates OFF"], group=grpSYM, tooltip="WHICH GATES ARE TSLA-SPECIFIC, in one switch. Three filters here were fitted on TSLA and describe no other symbol; on a non-TSLA chart they quietly subtract trades for reasons never measured on that symbol. Leave this on 'TSLA (as validated)' for TSLA -- it resolves every effective value to the input exactly as typed, so TSLA output is unchanged.\n\nNON-TSLA turns off:\n  1. Max Prior Realised Daily Vol (4.92%) -- fitted on TSLA 2024-25 and justified by a TSLA-specific mechanism (a close-based BE stop costs more when a high-vol bar closes further past the level). It skips 10% of TSLA days but 48% of SPCX days.\n  2. Entry cutoff (12:00) -- the post-noon cohort was net-negative over 5 years OF TSLA.\n  3. PD-level tag-and-reject exit -- measured and TV-validated on TSLA only; it costs money on SPCX.\n\nIt deliberately does NOT touch Max OR Width ($8): that gate was tested on SPCX and EARNS its place -- removing it cut return and doubled the worst trade. If $8 is the wrong scale for your symbol, use the price-scaling box above instead.\n\nMEASURED ON SPCX (SpaceX, IPO 2026-06-12), 2026-06-15..08-12, 41 sessions, B1 at $10k notional: as-shipped +22.4% vs this preset +49.3%, PF 2.02 -> 2.33, win rate 42% -> 56%. Robustness improves too, which is the unusual part: net excluding the best 3 trades goes -$1.26 -> +$32.84 and bootstrap P(net<=0) 0.075 -> 0.01.\n\nCAVEAT: 52 trades over two months of a brand-new listing that went $192 -> $108 -> $146. It clears its significance tests and both no-signal controls, which nine other candidate symbols did not -- but that is grounds for a forward test, not for TSLA-sized risk.\n\nPROFILE CHOICE ON A NON-TSLA CHART: do not read the Strategy Tester gap between profiles as a result. On SPCX all five profiles take the IDENTICAL 52 entries, so they can be compared PAIRED -- and paired, nothing separates them. Best p across all ten pairs 0.166; D1 - B1 p=0.317; B1 - C2 is +$4.83/sh but FLIPS SIGN to -2.40 if you drop one day. The 58-60% win rate every profile shows here is this preset, not the profile. Pick one and keep it (B1 matches TSLA). The one profile-level result that DID replicate on SPCX is C2's OR-width target beating the fixed $2 it replaced, +45.9% vs +29.2%, same direction as TSLA.", display=display.none)
// The vol gate is deliberately NOT scaled: 'Max Prior Realised Daily Vol (%)' is already a
// percentage, so it is price-scale-free. It is still TSLA-fitted though (4.92% was set on 2024-25
// TSLA), so on a more volatile symbol it will skip days on its own -- the table's RVol row goes red.

grpE = "Entry"
bufferPctOR = input.float(10.0, "Breakout Buffer (% of OR width)", step=0.5, group=grpE, display=display.none)
tradeQty    = input.float(1.0,  "Units Per Trade", minval=0.01, group=grpE, display=display.none)
shareQty    = input.int(25,     "Share quantity (Shares mode, per 1.0-unit trade)", minval=1, group=grpE, tooltip="v3.7 (was 'Shares per unit'): your FIXED share size, configured here like the Option-contracts input. Every order and webhook JSON quantity = Units Per Trade x this (default 1.0 x 25 = 25 sh, ~$10k unleveraged on TSLA); the risk-parity REVERSAL scales off it (can exceed it up to ~2x before the $-risk cap; margin_long/short are 0 so it isn't rejected). Strategy Tester P&L = this x the Python per-unit figures. Keep EQUAL to the indicator's 'Share quantity' input.", display=display.none)

grpX = "Exit tuning (which apply depends on the Profile)"
maxCapOverride  = input.float(0.0,  "Max Stop override ($, 0 = use profile: C1=6 else 5)", step=0.5, group=grpX, display=display.none)
adaptiveTPScale = input.float(0.75, "Adaptive TP - OR Width Multiplier (manual)", step=0.05, group=grpX, tooltip="ONLY READ WHEN \"Use each profile's ADOPTED defaults\" (Profile group) IS UNTICKED. While that box is ticked -- the default -- this is ignored and the multiplier is 0.75 on D1, 1.00 on A1/B1/C1/C2. Target distance from entry = max(the floor below, OR width x this).", display=display.none)
adaptiveTPMin   = input.float(2.14, "Adaptive TP — Minimum Floor $ (A1/B1)", step=0.01, group=grpX, display=display.none)
atrTPMult       = input.float(0.25, "ATR TP Multiplier x 14d ATR (C1)", step=0.01, group=grpX, display=display.none)
atrTPMin        = input.float(1.0,  "ATR TP Floor $ (C1)", step=0.25, group=grpX, display=display.none)
atrPeriod       = input.int(14,     "ATR Period (daily bars, C1)", minval=2, group=grpX, display=display.none)
fixedTP         = input.float(2.0,  "Fixed TP $ (C2)", step=0.25, group=grpX, display=display.none)
beTrigger       = input.float(0.55, "BE Retrace Trigger (% of OR width)", step=0.05, group=grpX, display=display.none)
beTrailAmt      = input.float(0.25, "BE Trail Amount ($)", step=0.01, group=grpX, display=display.none)
beRealistic     = input.bool(true,  "Realistic resting stop: a BE-retrace can't protect its own firing bar (Wick mode only)", group=grpX, tooltip="Only matters in Wick stop mode. ON = the stop moved to break-even rests from the NEXT bar (a bar firing BE-retrace AND hitting base SL fills at base SL). OFF = old optimistic look-ahead.", display=display.none)
stopTrigger     = input.string("Close (bar closes beyond)", "Stop trigger", options=["Close (bar closes beyond)", "Wick (any touch)"], group=grpX, tooltip="ADOPTED 2026-07-14 (default Close): the STOP fires only when the bar CLOSES beyond the level and flattens at the close — skips wick fakeouts (+42-46% net / DD -40% over 2022-26, flips 2024 positive; walk-forward OOS-confirmed). The TP stays a resting limit (favorable wick fill). Wick = the old resting stop (any touch fills at the level; beRealistic then applies).", display=display.none)
stopClose = str.startswith(stopTrigger, "Close")
partialPct      = input.float(25.0, "Partial Exit Quantity % (A1/B1/C1)", step=1.0, group=grpX, display=display.none)
runnerMult      = input.float(0.75, "Runner Peak-Trail x OR width (A1)", step=0.05, group=grpX, display=display.none)
vwapArmProfit   = input.float(1.0,  "VWAP Cross — arm after profit $ (B1/C1)", step=0.25, group=grpX, display=display.none)
ttAtrPeriod     = input.int(5,      "ATR Trail — ATR Period (D1)", minval=1, group=grpX, display=display.none)
ttHhvPeriod     = input.int(10,     "ATR Trail — HHV/LLV Period (D1)", minval=1, group=grpX, display=display.none)
ttMult          = input.float(2.5,  "ATR Trail — ATR Multiplier (D1)", step=0.1, group=grpX, tooltip="D1 runner exit = the 'TRADE TASTIC' chandelier: line = HHV(high - mult*ATR(period), hhv) for longs (mirrored for shorts); moves only on a bar that CLOSES beyond it AND extends (close > prev close); the runner flattens when a bar CLOSES across the line. Mult sweep 1.5-3.5 tested 2026-07-23: no setting wins 2024+2025+2026 together.", display=display.none)

grpC = "Entry Confirmation"
confirmBreakout    = input.bool(false, "Require confirmation candle (2-candle break)", group=grpC, tooltip="DEFAULT OFF: net-negative under the resting stop.", display=display.none)
requireTrendCandle = input.bool(true,  "Confirmation candle must be with-trend", group=grpC, display=display.none)

grpV = "Reversal"
revQtyMult = input.float(2.0, "Reversal Size Multiplier (before risk cap)", step=0.5, group=grpV, display=display.none)
revRiskCap = input.float(6.0, "Reversal Dollar-Risk Cap ($, 0=off)", step=0.5, group=grpV, display=display.none)

grpO = "Options via TradersPost (webhook)"
orderAsset     = input.string("Shares", "Order asset", options=["Shares", "Options"], group=grpO, tooltip="Shares = the stock JSON (Buy/Sell/Exit, rounded shares). Options = TradersPost options JSON: a LONG signal buys a CALL, a SHORT signal buys a PUT, any full exit closes. WORKS ON ALL PROFILES incl A1/B1/C1: in Options mode the 25% partial's webhook is SUPPRESSED, so the single contract HOLDS through the partial and closes only at the runner's final exit (VWAP / trail / BE / close-stop / EOD) — matching the real 0DTE option backtest (A1/B1/C1 >> C2 on options). The Strategy Tester still shows the SHARE-signal P&L; real option P&L (delta/theta/IV) is NOT backtestable here. The suppressed partial fires an informational text alert ('NO OPTIONS ACTION ... contract holds') that TradersPost ignores (harmless).", display=display.none)
optContracts   = input.int(2,        "Option contracts (quantity)", minval=1, group=grpO, tooltip="DEFAULT 2. The real 0DTE backtest figures are PER CONTRACT, so 2 contracts = 2x P&L AND 2x premium at risk (~$465/ct -> ~$930/trade on TSLA, ~9% of a $10k account). Losses are capped small (~-$97/ct). Raise/lower to your risk tolerance.", display=display.none)
optExpiration  = input.string("Friday (weekly)", "Option expiration", options=["Friday (weekly)", "+0 days", "+1 days", "+2 days", "+3 days", "+7 days"], group=grpO, tooltip="DEFAULT since v3.9.2 (2026-08-09) = 'Friday (weekly)': computes days-to-Friday DYNAMICALLY each day (Mon +4 .. Fri +0), so it ALWAYS resolves to a listed contract on any weekday, and it is the leg the whole published options history was actually priced on. WHY IT CHANGED: TSLA listed FRIDAY-ONLY expiries until 2026-02-02, so the 2025-01..2026-07 '0DTE' figures were ~85% Friday contracts at 1-4 DTE — the old 'weekly beats 0DTE by 3-5%' claim compared a contract to itself. On 2026 data, where the two legs are finally distinct, WEEKLY wins on 5 of 5 profiles in 3 independent windows (Jan-May, Jun-Jul, and the forward ledger's 70 true-0DTE trades ~30% less loss). COST: ~22% more premium per contract. '+0 days' = nearest listed on/after today: true 0DTE on Mon/Wed/Fri but it silently rolls to 1DTE on Tue/Thu because TSLA has NO daily expiries (unlike SPX). The fixed '+2'/'+3 days' hit Friday only early in the week and roll into NEXT week from Wed on — manual experiments only.", display=display.none)
optStrikesAway = input.int(0,        "Strikes away from ATM (0 = ATM)", minval=0, group=grpO, display=display.none)
optQtyMode     = input.string("Fixed contracts", "Option quantity mode", options=["Fixed contracts", "TradersPost sizing (omit quantity)"], group=grpO, tooltip="Fixed contracts (default) = the webhook sends the 'Option contracts' quantity. 'TradersPost sizing' = the entry JSON OMITS the quantity field so TradersPost's strategy-level position sizing decides the contract count — set 'Amount per position' ~$1,100 there (+ a max-quantity cap ~4 if available). WHY: the 2026-07 analysis found fixed-DOLLAR sizing (contracts = floor($1,100/premium), cap 4, skip if unaffordable) beats fixed 2ct by +49-63% with LOWER premium at risk — cheap-premium days carry the edge. VERIFY IN PAPER FIRST: TradersPost's docs don't state whether 'Amount per position' divides by the option PREMIUM (correct) or the underlying price (wrong) for options — watch one fill's contract count before trusting it. Exits are unaffected (action=exit closes the whole position).", display=display.none)
optQtyFixed    = str.startswith(optQtyMode, "Fixed")
partialAsOrder = input.bool(false,   "Partial exit as opposite-side order (Shares mode)", group=grpO, tooltip="For platforms where action=exit ALWAYS flattens the whole position and ignores the quantity (cannot split). ON: the 25% partial fires as a plain opposite-side order — long -> action=Sell qty N, short -> action=Buy qty N — so a NETTING platform reduces the position by N and the 75% runner keeps riding. The runner/stop/VWAP/EOD exits still send the normal full 'Exit'. WARNING: only works if your platform NETS an opposite-side order against the open position; if it REVERSES (flatten + open opposite), leave OFF. Designed for the default Close stop mode; in Wick mode a stop-out day sends Sell-partial + Exit back-to-back (still ends flat). Test one partial fill in paper first. OFF = the original Exit-with-quantity JSON (TradersPost honors it).", display=display.none)

// ---- WEBHOOK ALERTS: per-order JSON via alert_message. In TradingView set the alert message to
// {{strategy.order.alert_message}} (NOT {{strategy.order.action}} — that only outputs buy/sell, never "Exit").
//   Shares  : action Buy (long entry) / Sell (short entry) / Exit (any close); quantity = ROUNDED whole shares.
//   Options : TradersPost — long->BUY CALL, short->BUY PUT (always action=buy; optionType carries direction),
//             full-exit->"exit"; contracts + 0DTE ATM via inputs. Leave "Invert puts" UNCHECKED in TradersPost.
//             WORKS ON ALL PROFILES: the 25% partial's webhook is auto-suppressed so 1 contract HOLDS to the
//             runner exit. BARCLOSE-CORRECTED 2026-07-20 (old figures carried a 5-min entry lookahead):
//             @1ct barclose 2025-01..2026-07-17 (UPDATED 2026-07-25, incl D1 + OR-width C2):
//             A1 +$12.9k / D1 +$11.3k / B1 +$11.2k / C1 +$10.1k / C2 +$4.2k (the v3.5 OR-width TP
//             flipped C2 positive; old fixed-$2 C2 was -$1k). 2026 YTD: A1 +$9.0k > D1 +$7.5k > B1 +$5.8k.
//             ^ READ AS **WEEKLY**, NOT 0DTE: TSLA had FRIDAY-ONLY expiries until 2026-02-02, so ~85% of
//             that window could only ever be priced on Friday contracts (1-4 DTE). See the v3.9.2 note.
//             EXPIRY: on 2026 data (where 0DTE contracts actually exist) WEEKLY beats true-0DTE on 5 of 5
//             profiles in 3 independent windows, at ~22% more premium. TSLA lists only ~Mon/Wed/Fri expiries
//             (SPX is daily) and TradersPost '+N days' = nearest listed on/after today+N, so a FIXED offset
//             cannot target Friday: 'Friday (weekly)' computes the +N dynamically. DEFAULT since v3.9.2.
//             CONCENTRATION WARNING: 91% of 2026's options P&L is Jun-mid-Jul (34 of 143 trades). Jan-May
//             2026 weekly @1ct: A1 +$785 only, and B1/C1/C2 NEGATIVE. Size for five flat months.
// 'Friday (weekly)' -> days until this week's Friday, else the dropdown string verbatim.
f_expStr() =>
    if optExpiration == "Friday (weekly)"
        int dtf = dayofweek.friday - dayofweek(time, "America/New_York")   // Mon..Fri -> 4..0
        "+" + str.tostring(math.max(dtf, 0)) + " days"
    else
        optExpiration
f_msg(act, q) =>
    string out = na
    if orderAsset == "Options"
        if act == "Exit"
            out := '{"ticker":"{{ticker}}", "action":"exit"}'
        else
            // Always BUY-to-open: direction is carried by optionType (call/put). TradersPost treats an
            // explicit put contract with action=sell as SELL-TO-OPEN a short put (unless the opt-in
            // "Invert puts" strategy setting is enabled) — leave "Invert puts" UNCHECKED with these signals.
            ot = act == "Buy" ? "call" : "put"
            // v3.8: in "TradersPost sizing" mode the quantity field is OMITTED so the TradersPost
            // strategy-level position sizing (e.g. "Amount per position" dollar budget) decides the
            // contract count — the July analysis showed fixed-DOLLAR sizing beats fixed contracts
            // +49-63%. An explicit quantity in the JSON would override it, hence the omission.
            qpart = optQtyFixed ? '"quantity":' + str.tostring(optContracts) + ', ' : ''
            out := '{"ticker":"{{ticker}}", "action":"buy", ' + qpart + '"expiration":"' + f_expStr() + '", "optionType":"' + ot + '", "strikesAway":' + str.tostring(optStrikesAway) + '}'
    else
        out := '{"ticker":"{{ticker}}", "action":"' + act + '", "quantity":' + str.tostring(q, "#") + ', "price":"{{close}}"}'
    out

grpU = "Display"
showLabels = input.bool(false, "Show Labels", group=grpU, tooltip="Turn OFF for 30/90/365-day runs (TradingView caps labels at 500).", display=display.none)
showLevels = input.bool(true, "Show Levels", group=grpU, display=display.none)
showLvlLbl = input.bool(true, "Tag the OR / trigger lines", group=grpU, tooltip="v3.9.5: draws a small 'OR H 331.20' / 'LONG > 331.55' tag at the RIGHT END of each day's segment. The two OR tags sit INSIDE the opening range and the two trigger tags OUTSIDE it, so the ORH/long pair and the ORL/short pair never overlap even when the buffer is a few cents.", display=display.none)
orKeep     = input.int(10, "Days of OR / trigger segments to keep", minval=1, maxval=60, group=grpU, tooltip="v3.9.5: the OR High / OR Low / Long / Short levels are now drawn as one SEGMENT PER DAY instead of one continuous plot, so they stop at that session's last bar. Each session costs 4 line + 4 label objects; older sessions are DELETED once this many days are on screen. Keep it modest (10-20) for a 365-day Strategy Tester run — TradingView caps lines and labels at 500 each and the prior-day segments plus the trade labels share the same budget.", display=display.none)

grpP = "Prior-Day Levels (PDH / PDL / PDC / PDO)"
showPD    = input.bool(true, "Show prior-day levels", group=grpP, tooltip="DIAGNOSTIC ONLY (v3.9.3): these four lines are DRAWN, never traded — no entry, exit, stop, target, day-skip or webhook rule reads them, so turning them on cannot change a single Strategy Tester trade. They are yesterday's completed RTH daily bar (Open/High/Low/Close) held flat across today. LEGEND: PDH = MAGENTA thick solid, PDL = BLUE thick solid, PDC = WHITE dotted, PDO = ORANGE dashed.", display=display.none)
showPDLbl = input.bool(true, "Tag the end of each day's line", group=grpP, tooltip="v3.9.4: draws a small 'PDH 331.20' tag just ABOVE the RIGHT END of each day's segment, so every line identifies itself without the legend. 4 tags per session, bounded by the 'days to keep' setting below.", display=display.none)
pdKeep    = input.int(10, "Days of prior-day segments to keep", minval=1, maxval=60, group=grpP, tooltip="v3.9.4: the lines are now one SEGMENT PER DAY instead of a chart-wide stepline. Each session costs 4 line + 4 label objects and older sessions are DELETED once this many are on screen. Keep it modest (10-20) for a 365-day Strategy Tester run — TradingView caps lines and labels at 500 each and the trade labels compete for the same budget.", display=display.none)
showPDH   = input.bool(true, "PDH — prior day HIGH (magenta, solid)", group=grpP, display=display.none)
showPDL   = input.bool(true, "PDL — prior day LOW (blue, solid)", group=grpP, display=display.none)
showPDC   = input.bool(true, "PDC — prior day CLOSE (white, dotted)", group=grpP, display=display.none)
showPDO   = input.bool(true, "PDO — prior day OPEN (orange, dashed)", group=grpP, display=display.none)

// ---- PD-LEVEL TAG-AND-REJECT EXIT (v3.9.4) — EXPERIMENTAL, DEFAULT OFF ----
grpPX = "PD-Level Exit (tag-and-reject)"
pdxOn      = input.bool(true, "Enable PD-level tag-and-reject exit", group=grpPX, tooltip="DEFAULT ON since v3.9.6 (it was OFF in v3.9.4-v3.9.5). Measured right here on C1 over 2025-08-11..2026-08-10 by exporting this script twice, ticked and unticked: $17,554 vs $13,623 = +$3,932 (+29%), PF 1.76 vs 1.52, win rate 55.2% vs 50.4%, worst trade unchanged, positive in both year-cells. The 54 fires are right 70% of the time. CAVEAT: the body threshold below was fitted in-sample on that same span with no holdout, and the Strategy Tester charges no commission or slippage. Untick to get the v3.9.3 baseline back. ON: the position is flattened at the close of a bar that tags a prior-day level lying AHEAD of the trade, closes rejected back off it, AND has a small body. Ranked BELOW the stop, the target/partial and the runner exits — it can only claim a bar none of them wanted — and it does NOT arm the reversal (only Base SL / BE Stop / BE Trail do), matching orb_engine.py. Sends a normal full-flatten webhook.", display=display.none)
pdxMaxBody = input.float(0.25, "Max rejection-candle body (|C-O| / (H-L))", minval=0.01, maxval=1.0, step=0.05, group=grpPX, tooltip="THE KNOB THAT MATTERS, and it runs OPPOSITE to intuition. A big decisive candle closing back off the level is worthless — it is a trend bar that happens to touch a line, and price continues. What predicts a real rejection is a SMALL body: a doji or pin that runs into the level and cannot close through it. 5-year deltas: no filter (1.0) = -$3,796 to -$5,466 on every profile; 0.25 = +$1,248 A1 / +$2,983 B1 / +$3,487 C1 / +$755 D1. The 0.10-0.25 band is a flat plateau; 0.35 is +$207 and 0.40-0.50 are negative. A full D1 sweep (2022-2026, per unit, baseline 450.5) put 0.25 at the TOP of that plateau — 0.10 +4.9% / 0.15 +7.2% / 0.20 +7.0% / 0.25 +7.8% / 0.30 +0.6% — so 0.25 is right for all four profiles and the earlier note that D1 preferred 0.15 is withdrawn. D1 is simply the weakest beneficiary (+7.8% vs C1 +25.0 / B1 +21.1 / A1 +10.6).", display=display.none)
pdxZone    = input.float(0.05, "Tag zone (x today's TP distance)", minval=0.0, maxval=0.50, step=0.01, group=grpPX, tooltip="How close the bar's extreme must come to the level to count as a tag, as a fraction of the adaptive TP distance. 0.05 of a $3.74 TP distance = about 19 cents.", display=display.none)
pdxLevels  = input.string("All four (PDO/PDH/PDL/PDC)", "Which levels may trigger it", options=["All four (PDO/PDH/PDL/PDC)", "PDH + PDL only", "PDC only"], group=grpPX, tooltip="All four is the validated default. PDC-only and PDH/PDL-only were swept WITHOUT the body filter and lost on every profile; they have not been re-swept with it.", display=display.none)
pdxAhead   = input.bool(false, "Levels AHEAD of entry only", group=grpPX, tooltip="UNTICKED IS THE DEFAULT SINCE v3.9.8 (\"both sides\"), adopted by user call AGAINST the measurement — tick it to get the v3.9.4-v3.9.7 behaviour back. TICKED: only a level the trade is moving TOWARD can trigger the exit. UNTICKED: a level BEHIND the entry counts too, so closing back through a level the trade had already won is also an exit (\"you lost the level\"). Motivation: on 2026-08-04 and 2026-08-11 the short triggered about 33 cents below PDC and was immediately reclaimed. COST, per unit 2022-01-03..2026-08-10, unticked vs ticked: A1 485.6 vs 502.0, B1 558.3 vs 575.9, C1 556.4 vs 573.2, D1 480.3 vs 483.5. B1 by year: 2022 -21.2 / 2023 -5.1 / 2024 -4.8 / 2025 -3.4 / 2026 +17.0 — four of five years worse, win rate 46.2% to 44.2%. Only 2026 improves, and 2026 is also the only year the motivating days came from.", display=display.none)

// ==================== v3.9.11 SYMBOL PRESET (which gates are TSLA-specific) ====================
// Resolved once, after every input above has been read, so there is exactly ONE definition of each
// effective value and the three use sites cannot drift apart. On the TSLA preset each of these is
// the raw input, so TSLA behaviour is bit-identical to v3.9.10.
isNonTSLA  = symPreset != "TSLA (as validated)"
effRvolCap = isNonTSLA ? 1.0e9 : maxRvolPct   // 1e9 => `rvol20 > effRvolCap` can never be true
effCutOn   = isNonTSLA ? false : entryCutOn
effPdxOn   = isNonTSLA ? false : pdxOn

// ============ PER-PROFILE ADOPTED DEFAULTS (added v3.9.13, narrowed v3.9.14) ============
// Resolved here, next to the symbol preset, so there is exactly ONE definition of the effective
// value and the use sites cannot drift apart. Python has a config FILE per profile; Pine has one
// input set and a dropdown, so a per-profile value has to be resolved rather than typed.
// v3.9.14: the entry cutoff LEFT this block -- 11:30 is now house-wide, so `entryCutH/M` are read
// directly again and only the Adaptive-TP multiplier still differs by profile.
// Untick `profDefaults` and the multiplier falls back to the raw input for every profile.
effTPScale = profDefaults ? (isD1 ? 0.75 : 1.00) : adaptiveTPScale

maxCapSL = maxCapOverride > 0 ? maxCapOverride : (isC1 ? 6.0 : 5.0)

// ==================== "TRADE TASTIC" ATR TRAIL (D1 runner exit) ====================
// ONE line for BOTH directions, exactly the original script: TS = HHV(high - mult*ATR, hhv);
// it MOVES only on a bar that closes above the HHV AND extends (close > prev close) — else it
// holds. Color = close > TS. LONG runner exits on green->red (close <= TS); SHORT runner exits
// on red->green (close > TS) — after a waterfall the falling HHV drags the accepted level down,
// which is how the line comes back under price to catch the cover flip (2026-07-23: flip 10:35
// where the removed "mirror" line exited 11:55). First 16 bars pin to the close (script warm-up).
ttATR = ta.rma(ta.tr(true), ttAtrPeriod)
ttHHV = ta.highest(high - ttMult * ttATR, ttHhvPeriod)
var float ttTS = na
if bar_index < 16
    ttTS := close
else
    ttTS := close > ttHHV and close > close[1] ? ttHHV : ttTS

// ==================== PRIOR-DAY VOL + DAILY ATR (no repaint) ====================
f_priorRvol() =>
    r = ta.change(close) / close[1] * 100.0
    s = ta.stdev(r, volLookback, false)
    s[1]
rvol20 = request.security(syminfo.tickerid, "D", f_priorRvol(), lookahead=barmerge.lookahead_on)
f_priorATR() =>
    a = ta.sma(ta.tr(true), atrPeriod)
    a[1]
dailyATR = request.security(syminfo.tickerid, "D", f_priorATR(), lookahead=barmerge.lookahead_on)

// ==================== PRIOR-DAY LEVELS (PDH/PDL/PDC/PDO) — DIAGNOSTIC, NOT TRADED ====================
// Yesterday's completed daily bar, held flat across today. Taking [1] INSIDE the request and pairing
// it with lookahead_on is the standard non-repainting idiom (identical to the rvol/ATR calls above):
// it returns the LAST CLOSED daily bar, so today's still-forming O/H/L/C can never leak in.
f_pdLevels() =>
    [open[1], high[1], low[1], close[1]]
[pdO, pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", f_pdLevels(), lookahead=barmerge.lookahead_on)

// ==================== v3.9.10 SYMBOL PRICE SCALE (portability only, OFF by default) ====================
// Converts the eight DOLLAR-denominated inputs into this symbol's price scale. Units conversion and
// nothing else -- no rule, no ordering, and no ratio-valued input (buffer % of OR, BE trigger % of
// OR, runner x OR, adaptive TP multiplier, partial %, PD body/zone, rvol %) is touched, because
// those are already dimensionless and travel between symbols unchanged.
//
// With pxAutoOn false, pxScale is exactly 1.0 and `x * 1.0 == x` bit-for-bit in IEEE-754, so the
// production TSLA backtest is unchanged from v3.9.8. That invariant is the point of the design:
// this feature must not be able to move a traded number.
//
// Reference is the PRIOR daily close, not `close`: fixed for the whole session (a live-updating
// scale would move the stop and the target under an open position mid-bar) and already available
// above as a non-repainting request.security.
pxScaleRef = not na(pdC) ? pdC : close
pxScale    = pxAutoOn and pxRef > 0 and pxScaleRef > 0 ? pxScaleRef / pxRef : 1.0
maxORWidthS    = maxORWidth    * pxScale
maxCapSLS      = maxCapSL      * pxScale
adaptiveTPMinS = adaptiveTPMin * pxScale
atrTPMinS      = atrTPMin      * pxScale
fixedTPS       = fixedTP       * pxScale
beTrailAmtS    = beTrailAmt    * pxScale
vwapArmProfitS = vwapArmProfit * pxScale
revRiskCapS    = revRiskCap    * pxScale

// ==================== STATE ====================
var float orHigh = na
var float orLow = na
var float orWidth = na
var bool skipVol = false
var bool skipWide = false
var bool daySkipped = false
var bool firstTaken = false
var bool active = false
var int tdir = 0
var float entry = na
var float stop = na
var float tp = na
var int entryBar = na
var bool inRev = false
var bool suppressPartial = false
var string entryId = ""
var bool beTrig = false
var float beLevel = na
var float qtyTotal = na
var float posSh = na          // ROUNDED share count of the current position (whole shares for the webhook)
var bool part1 = false
var bool tpWasHit = false
var float runnerPeak = na
var bool vwapArmed = false
var bool lastWasTrail = false   // A1: was the last-placed runner stop the PEAK-TRAIL (reason "Trail",
                                // does NOT arm) vs the BE/base stop (arms)? mirrors engine stop-first order.
var int primDir = 0
var bool primStopped = false

// ==================== NEW DAY / OPENING RANGE ====================
isNewDay = session.isfirstbar_regular
isORbar = orStart == "09:45" ? (hour == 9 and minute == 45) : isNewDay
sessVwap = ta.vwap(hlc3, isNewDay)
isEODbar = (hour * 60 + minute) >= (eodHour * 60 + eodMin)
// v3.9.7 HALF-DAY FLATTEN FIX. `session.islastbar_regular` does NOT fire on TSLA's early-close final
// bar (12:55 on the day after Thanksgiving), so on those sessions nothing flattened at all: the next
// bar was a new day, `isNewDay` reset `active`, and the orphaned position sat until the FOLLOWING
// session's 15:50 "EOD flat" safety net. Visible in the v3.9.6 exports as overnight carries on
// 2012-11-23, 2017-11-24 (C1 only) and 2018-11-23 — the last a -$121.20 short held through a
// three-day weekend, and the tell was the fill comment reading "EOD flat" (the safety net) instead
// of "EOD". Derive the session's real end from the daily bar's close time instead: time_close("D")
// is 13:00 on an early close and 16:00 otherwise, so this fires on the session's genuine last bar
// and — with process_orders_on_close — flattens at that bar's close, which is exactly what
// orb_engine.py's `last_ts_by_date` does. On a full session it lands on the 15:55 bar, which
// isEODbar already claimed, so normal days are trade-for-trade unchanged.
isSessLastBar = not na(time_close("D")) and time_close >= time_close("D")
isLastBar = session.islastbar_regular or isSessLastBar
isFlattenBar = isEODbar or isLastBar

if isNewDay
    orHigh := na
    orLow := na
    orWidth := na
    daySkipped := false
    firstTaken := false
    active := false
    tdir := 0
    entry := na
    stop := na
    tp := na
    entryBar := na
    inRev := false
    suppressPartial := false
    entryId := ""
    beTrig := false
    beLevel := na
    qtyTotal := na
    part1 := false
    tpWasHit := false
    runnerPeak := na
    vwapArmed := false
    primDir := 0
    primStopped := false

if isORbar
    orHigh := high
    orLow := low
    orWidth := high - low
    skipVol := not na(rvol20) and rvol20 > effRvolCap
    skipWide := orWidth > maxORWidthS
    daySkipped := skipVol or skipWide

longBrk = not na(orHigh) ? orHigh + orWidth * bufferPctOR / 100.0 : na
shortBrk = not na(orLow) ? orLow - orWidth * bufferPctOR / 100.0 : na
// target distance by profile: Fixed (C2) / ATR (C1) / Adaptive OR-scaled (A1/B1)
tpDist = tpModeSel == "Fixed" ? fixedTPS : tpModeSel == "ORw" ? orWidth : tpModeSel == "ATR" ? (not na(dailyATR) ? math.max(atrTPMinS, atrTPMult * dailyATR) : fixedTPS) : (not na(orWidth) ? math.max(adaptiveTPMinS, orWidth * effTPScale) : na)
canTrade = session.ismarket and not isORbar and not daySkipped and not na(orHigh) and not isFlattenBar and (not effCutOn or hour * 60 + minute <= entryCutH * 60 + entryCutM)

// ==================== PRIMARY ENTRY ====================
longConfirm  = not confirmBreakout or (close[1] > longBrk and (close >= open or not requireTrendCandle))
shortConfirm = not confirmBreakout or (close[1] < shortBrk and (close <= open or not requireTrendCandle))
if canTrade and not active and not firstTaken and strategy.position_size == 0
    if close > longBrk and longConfirm
        entryId := "L"
        posSh := math.round(tradeQty * shareQty)
        strategy.entry(entryId, strategy.long, qty=posSh, alert_message=f_msg("Buy", posSh))
        active := true
        tdir := 1
        inRev := false
        suppressPartial := false
        entry := close
        stop := maxCapSLS > 0 ? math.max(orLow, close - maxCapSLS) : orLow
        tp := close + tpDist
        beLevel := orHigh - beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := tradeQty
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primDir := 1
        firstTaken := true
        if showLabels
            label.new(bar_index, low, "LONG " + str.tostring(close, format.mintick), style=label.style_label_up, color=color.rgb(7,170,75), textcolor=color.white, size=size.small)
    else if close < shortBrk and shortConfirm
        entryId := "S"
        posSh := math.round(tradeQty * shareQty)
        strategy.entry(entryId, strategy.short, qty=posSh, alert_message=f_msg("Sell", posSh))
        active := true
        tdir := -1
        inRev := false
        suppressPartial := false
        entry := close
        stop := maxCapSLS > 0 ? math.min(orHigh, close + maxCapSLS) : orHigh
        tp := close - tpDist
        beLevel := orLow + beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := tradeQty
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primDir := -1
        firstTaken := true
        if showLabels
            label.new(bar_index, high, "SHORT " + str.tostring(close, format.mintick), style=label.style_label_down, color=color.rgb(243,76,76), textcolor=color.white, size=size.small)

// ==================== STATE DE-SYNC + REVERSAL ARMING (runs BEFORE the reversal entry) ============
// The OCO fills INTRABAR and is detected on the NEXT bar (position flat, active still true). This block
// MUST run before the reversal-entry block: a primary stop that fills on bar N is then armed here on N+1
// and the reversal can fire the SAME bar (N+1), matching orb_engine.py / the indicator. (When it ran
// AFTER the reversal block, arming happened a bar too late and the reversal entered ~1 bar worse -> it
// bled the reversal edge, ~35% of net.) Arm only on a BASE/BE STOP (reasons Base SL/BE Stop/BE Trail,
// L933): a peak-trail exit is reason "Trail" (lastWasTrail) and does NOT arm; C2 arms unless a TP win.
if active and strategy.position_size == 0 and bar_index > entryBar
    // C2 win detection must be race-proof: TV reflects the intrabar OCO fill in position_size
    // on the SAME bar, so this block can run BEFORE the exit-engine mirror sets tpWasHit. Also
    // test the current bar's target touch inline so a TP win never arms a phantom reversal.
    c2Won = tpWasHit or (not na(tp) and (tdir == 1 ? high >= tp : low <= tp))
    stoppedOut = usePartial ? (not lastWasTrail) : (not c2Won)
    if not inRev and stoppedOut
        primStopped := true
        if showLabels
            label.new(bar_index, tdir == 1 ? low : high, "REV armed: need close " + (tdir == 1 ? "< " + str.tostring(orLow, format.mintick) : "> " + str.tostring(orHigh, format.mintick)), style=tdir == 1 ? label.style_label_up : label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
    strategy.cancel("P1")
    strategy.cancel("RUN")
    strategy.cancel("X")
    active := false
    tdir := 0
    inRev := false
    tp := na
    stop := na
    vwapArmed := false

// ==================== REVERSAL ENTRY (raw OR break · trail-to-EOD · risk-parity · NO target) ====
if canTrade and primStopped and not active and strategy.position_size == 0
    if primDir == 1 and close < orLow
        rpu = math.abs(close - orHigh)
        rq = revRiskCapS > 0 and rpu > 0 ? math.min(tradeQty * revQtyMult, revRiskCapS / rpu) : tradeQty * revQtyMult
        entryId := "RS"
        posSh := math.round(rq * shareQty)
        strategy.entry(entryId, strategy.short, qty=posSh, alert_message=f_msg("Sell", posSh))
        active := true
        tdir := -1
        inRev := true
        suppressPartial := true
        entry := close
        stop := orHigh
        tp := na
        beLevel := orLow + beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := rq
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primStopped := false
        if showLabels
            label.new(bar_index, high, "REV SHORT " + str.tostring(close, format.mintick) + "\nqty " + str.tostring(rq, "#.##"), style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)
    else if primDir == -1 and close > orHigh
        rpu = math.abs(close - orLow)
        rq = revRiskCapS > 0 and rpu > 0 ? math.min(tradeQty * revQtyMult, revRiskCapS / rpu) : tradeQty * revQtyMult
        entryId := "RL"
        posSh := math.round(rq * shareQty)
        strategy.entry(entryId, strategy.long, qty=posSh, alert_message=f_msg("Buy", posSh))
        active := true
        tdir := 1
        inRev := true
        suppressPartial := true
        entry := close
        stop := orLow
        tp := na
        beLevel := orHigh - beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := rq
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primStopped := false
        if showLabels
            label.new(bar_index, low, "REV LONG " + str.tostring(close, format.mintick) + "\nqty " + str.tostring(rq, "#.##"), style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.small)

// ==================== EXIT ENGINE — OCO brackets (never on the entry bar) ====================
if active and not na(stop) and bar_index >= entryBar
    vwapExited = false
    stopBarStart = stop        // the stop actually RESTING coming into this bar (pre BE-retrace)
    beFiredNow = false
    bool pdxHit = false         // v3.9.4 PD-level tag-and-reject (default OFF)
    bool partFilledNow = false  // the 25% partial mirrored THIS bar -> PD-level exit must yield to it
    if bar_index > entryBar
        // Step 1: BE Retrace (WICK trigger)
        if not beTrig and not na(beLevel)
            if (tdir == 1 ? low <= beLevel : high >= beLevel)
                stop := tdir == 1 ? math.max(stop, entry) : math.min(stop, entry)
                beTrig := true
                beFiredNow := true
        // Step 2: BE Trail
        if beTrig and beTrailAmtS > 0
            stop := tdir == 1 ? math.max(stop, high - beTrailAmtS) : math.min(stop, low + beTrailAmtS)
        // Step 2b: PD-LEVEL TAG-AND-REJECT (v3.9.4; default ON since v3.9.6, both-sides since v3.9.8)
        // — mirrors orb_engine.py `_pd_tag_reject`.
        // Only EVALUATED here; it is applied further down, after the stop/partial/runner have had their
        // chance, so the precedence matches the indicator's elif chain exactly.
        if effPdxOn and not na(entry) and not na(tpDist)
            rngBar = math.max(high - low, syminfo.mintick)
            if (math.abs(close - open) / rngBar) < pdxMaxBody and (tdir == 1 ? close < open : close > open)
                tolPD = pdxZone * tpDist
                usePDO = pdxLevels == "All four (PDO/PDH/PDL/PDC)"
                usePDC = pdxLevels != "PDH + PDL only"
                usePDHL = pdxLevels != "PDC only"
                // v3.9.8: `pdxAhead` off (the new default) drops the "level must lie ahead" guard, so a
                // level BEHIND the entry — one the trade had already won — also triggers on a reclaim.
                if usePDO and not na(pdO) and (not pdxAhead or (pdO - entry) * tdir > 0)
                    pdxHit := pdxHit or (tdir == 1 ? (high >= pdO - tolPD and close < pdO) : (low <= pdO + tolPD and close > pdO))
                if usePDHL and not na(pdH) and (not pdxAhead or (pdH - entry) * tdir > 0)
                    pdxHit := pdxHit or (tdir == 1 ? (high >= pdH - tolPD and close < pdH) : (low <= pdH + tolPD and close > pdH))
                if usePDHL and not na(pdL) and (not pdxAhead or (pdL - entry) * tdir > 0)
                    pdxHit := pdxHit or (tdir == 1 ? (high >= pdL - tolPD and close < pdL) : (low <= pdL + tolPD and close > pdL))
                if usePDC and not na(pdC) and (not pdxAhead or (pdC - entry) * tdir > 0)
                    pdxHit := pdxHit or (tdir == 1 ? (high >= pdC - tolPD and close < pdC) : (low <= pdC + tolPD and close > pdC))
        if usePartial
            // Step 3: mirror the 25% partial fill (P1 limit does the actual fill)
            if not suppressPartial and not part1 and not na(tp) and (tdir == 1 ? high >= tp : low <= tp)
                partFilledNow := true
                part1 := true
                tp := na
                if showLabels
                    label.new(bar_index, tdir == 1 ? high : low, noPartial ? (isD1 ? "TRAIL ARMED" : "RUNNER ARMED") : "PARTIAL " + str.tostring(partialPct, "#") + "%", style=tdir == 1 ? label.style_label_down : label.style_label_up, color=noPartial ? color.new(color.yellow, 30) : color.rgb(7,170,75), textcolor=noPartial ? color.black : color.white, size=size.tiny)
            // Step 4a: runner peak-trail level (A1; D1 uses the ATR trail in Step 4c instead)
            if part1 and not suppressPartial and not runnerVWAP and not isD1 and runnerMult > 0
                runnerPeak := na(runnerPeak) ? (tdir == 1 ? high : low) : (tdir == 1 ? math.max(runnerPeak, high) : math.min(runnerPeak, low))
            // Step 4b: runner VWAP-cross exit (B1/C1)
            if part1 and not suppressPartial and runnerVWAP
                if not vwapArmed and (tdir == 1 ? close - entry : entry - close) >= vwapArmProfitS
                    vwapArmed := true
                if vwapArmed and not na(sessVwap) and (tdir == 1 ? close <= sessVwap : close >= sessVwap)
                    strategy.cancel("P1")
                    strategy.cancel("RUN")
                    strategy.close(entryId, comment=(inRev ? "REV VWAP" : "VWAP Cross"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
                    if showLabels
                        label.new(bar_index, tdir == 1 ? high : low, (inRev ? "REV " : "") + "VWAP " + str.tostring(close, format.mintick), style=tdir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.aqua, 0), textcolor=color.white, size=size.small)
                    active := false
                    tdir := 0
                    inRev := false
                    tp := na
                    stop := na
                    vwapArmed := false
                    vwapExited := true
            // Step 4c: runner ATR-trail exit (D1) — the TRADE TASTIC color flip: long exits
            // close <= TS (green->red), short exits close > TS (red->green; SAME line)
            if part1 and not suppressPartial and isD1 and (tdir == 1 ? close <= ttTS : close > ttTS)
                strategy.cancel("P1")
                strategy.cancel("RUN")
                strategy.close(entryId, comment=(inRev ? "REV ATR Trail" : "ATR Trail"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
                if showLabels
                    label.new(bar_index, tdir == 1 ? high : low, (inRev ? "REV " : "") + "ATR TRAIL " + str.tostring(close, format.mintick), style=tdir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)
                active := false
                tdir := 0
                inRev := false
                tp := na
                stop := na
                vwapExited := true   // reuse the exited-this-bar flag: skip the bracket refresh below
        else
            // C2 full exit: mirror the target touch so a TP win does not arm the reversal
            if not na(tp) and (tdir == 1 ? high >= tp : low <= tp)
                tpWasHit := true
    if not vwapExited
        // Wick-mode resting-stop realism: a BE-retrace that fired THIS bar rests only from the NEXT bar.
        restStop = (beRealistic and beFiredNow) ? stopBarStart : stop
        beReason = beTrig ? ((tdir == 1 ? restStop > entry : restStop < entry) ? "BE Trail" : "BE Stop") : "Base SL"
        partSh = noPartial ? 0 : math.round(posSh * partialPct / 100)   // whole-share 25% partial; runner takes the remainder (all-runner / D1 full-trail: 0)
        runSh  = posSh - partSh
        trailLevel = (usePartial and part1 and not suppressPartial and not runnerVWAP and not isD1 and runnerMult > 0 and not na(runnerPeak)) ? (tdir == 1 ? runnerPeak - runnerMult * orWidth : runnerPeak + runnerMult * orWidth) : na
        isTrail = not na(trailLevel) and (tdir == 1 ? trailLevel >= stop : trailLevel <= stop)
        if usePartial and part1 and not suppressPartial
            lastWasTrail := isTrail
        else if usePartial
            lastWasTrail := false
        // stop level governing the remaining position this bar (A1 runner-trail folded in)
        curStop = not na(trailLevel) ? (tdir == 1 ? math.max(stop, trailLevel) : math.min(stop, trailLevel)) : stop
        // CLOSE-triggered stop: fire only when the bar CLOSES beyond the level -> flatten at the close.
        // No manual reset — the de-sync block arms the reversal next bar (a "Trail" exit does not arm).
        if stopClose and (tdir == 1 ? close <= curStop : close >= curStop)
            strategy.cancel("P1")
            strategy.cancel("RUN")
            strategy.cancel("X")
            strategy.close(entryId, comment=(inRev ? "REV " : "") + (isTrail ? "Trail" : beReason), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
        else if pdxHit and not partFilledNow and not tpWasHit
            // v3.9.4 PD-level tag-and-reject. Reached only when the stop did NOT fire this bar and the
            // target/partial did not claim it (the runner exits already returned via vwapExited), which
            // reproduces the indicator's slHit > TP/partial > runner > pdxHit ordering. Deliberately does
            // NOT set primStopped: this is not a stop-type exit, so it must not arm the reversal.
            strategy.cancel("P1")
            strategy.cancel("RUN")
            strategy.cancel("X")
            strategy.close(entryId, comment=(inRev ? "REV PD Level" : "PD Level"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
            if showLabels
                label.new(bar_index, tdir == 1 ? high : low, (inRev ? "REV " : "") + "PD LEVEL " + str.tostring(close, format.mintick), style=tdir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=size.small)
            active := false
            tdir := 0
            inRev := false
            tp := na
            stop := na
        else
            // Close mode: rest the TP limits only (stops are close-triggered above). Wick mode: OCO w/ resting stops.
            if not usePartial
                strategy.exit("X", from_entry=entryId, stop=(stopClose ? na : restStop), limit=tp, comment_loss=(inRev ? "REV " : "") + beReason, comment_profit=(inRev ? "REV TP" : "TP"), alert_message=f_msg("Exit", posSh))
            else if suppressPartial
                if not stopClose
                    strategy.exit("RUN", from_entry=entryId, stop=restStop, comment=(inRev ? "REV " : "") + beReason, alert_message=f_msg("Exit", posSh))
            else if not part1 and noPartial
                // All-runner (and D1 full-trail): NO TP order at all — the target touch only ARMS
                // the runner (the Step 3 mirror flips part1); wick mode still rests the full-size
                // protective stop. Nothing is scaled out, so the whole position leaves on ONE exit.
                if not stopClose
                    strategy.exit("RUN", from_entry=entryId, stop=restStop, comment=(inRev ? "REV " : "") + beReason, alert_message=f_msg("Exit", posSh))
            else if not part1
                // OPTIONS: suppress the 25% partial's webhook so the single contract HOLDS through the
                // partial and closes only at the runner's final exit (matches the A1/B1/C1 option backtest).
                // NEVER pass na here — an unset alert_message makes TV emit the LITERAL placeholder text
                // "{{strategy.order.alert_message}}" (v3.1 fix, seen live 2026-07-21). Send readable
                // non-JSON text instead: TradersPost ignores it, the TV notification stays meaningful.
                // SHARES: the partial sends its normal 25% exit. The runner/stop/VWAP/EOD full-flatten still
                // fires the option close, so nothing is missed.
                partAlert = orderAsset == "Options" ? "UDB-ORB INFO: 25% share-partial filled at target - NO OPTIONS ACTION, contract holds to the runner exit (TradersPost: ignore)" : f_msg(partialAsOrder ? (tdir == 1 ? "Sell" : "Buy") : "Exit", partSh)
                strategy.exit("P1", from_entry=entryId, qty=partSh, stop=(stopClose ? na : restStop), limit=tp, comment_loss=(inRev ? "REV " : "") + beReason, comment_profit="Partial @ TP", alert_message=partAlert)
                if not stopClose
                    strategy.exit("RUN", from_entry=entryId, qty=runSh, stop=restStop, comment=(inRev ? "REV " : "") + beReason, alert_message=f_msg("Exit", runSh))
            else
                if not stopClose
                    runnerStop = na(trailLevel) ? restStop : (tdir == 1 ? math.max(restStop, trailLevel) : math.min(restStop, trailLevel))
                    strategy.exit("RUN", from_entry=entryId, qty=runSh, stop=runnerStop, comment=(inRev ? "REV " : "") + (isTrail ? "Trail" : beReason), alert_message=f_msg("Exit", runSh))

// ==================== EOD FORCED CLOSE ====================
if active and isFlattenBar and tdir != 0
    strategy.cancel("P1")
    strategy.cancel("RUN")
    strategy.cancel("X")
    strategy.close(entryId, comment=(inRev ? "REV EOD" : "EOD"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
    if showLabels
        label.new(bar_index, close, (inRev ? "REV EOD " : "EOD ") + str.tostring(close, format.mintick), style=label.style_label_left, color=color.rgb(255,140,0), textcolor=color.white, size=size.small)
    active := false
    tdir := 0
    inRev := false
    tp := na
    stop := na

if strategy.position_size != 0 and isFlattenBar and not active
    strategy.close_all(comment="EOD flat", alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))

// ==================== VISUALS ====================
// ---- OR / TRIGGER LEVELS (v3.9.5) — one segment per day + a right-end tag, same pattern as the PD lines ----
// v3.9.4 drew these with plot(style_linebr). Even though orHigh/orLow reset to na overnight, a plot is one
// continuous series: TradingView joins the last bar of one session to the first bar of the next, so on a
// multi-day chart the aqua/lime/red levels visibly ran on into the following day. They are now four line
// objects per session, opened on that session's OR bar, extended only to its own bars, and never touched
// again. A small tag ("OR H 331.20", "LONG > 331.55") rides the right end so each line names itself.
// DRAWING ONLY — nothing here feeds an order, so the Strategy Tester result is unchanged.
cORH = color.new(color.aqua, 0)
cLBK = color.new(color.lime, 0)
cSBK = color.new(color.red, 0)
var line  lnORH = na
var line  lnORL = na
var line  lnLBK = na
var line  lnSBK = na
var label tgORH = na
var label tgORL = na
var label tgLBK = na
var label tgSBK = na
var line[]  orLineHist = array.new_line()
var label[] orTagHist  = array.new_label()

// retire yesterday's four segments on the FIRST bar of the new session, so nothing extends across the gap
// (this must happen at isNewDay, not at the OR bar — with orStart 09:45 the OR bar is three bars late)
if showLevels and isNewDay
    if not na(lnORH)
        array.push(orLineHist, lnORH)
    if not na(lnORL)
        array.push(orLineHist, lnORL)
    if not na(lnLBK)
        array.push(orLineHist, lnLBK)
    if not na(lnSBK)
        array.push(orLineHist, lnSBK)
    if not na(tgORH)
        array.push(orTagHist, tgORH)
    if not na(tgORL)
        array.push(orTagHist, tgORL)
    if not na(tgLBK)
        array.push(orTagHist, tgLBK)
    if not na(tgSBK)
        array.push(orTagHist, tgSBK)
    while array.size(orLineHist) > orKeep * 4
        line.delete(array.shift(orLineHist))
    while array.size(orTagHist) > orKeep * 4
        label.delete(array.shift(orTagHist))
    lnORH := na
    lnORL := na
    lnLBK := na
    lnSBK := na
    tgORH := na
    tgORL := na
    tgLBK := na
    tgSBK := na

// open today's four segments on the OR bar, once the range and the skip decision are both known.
//
// v3.9.10: this NO LONGER REQUIRES A TRADABLE DAY. The guard used to read `and not daySkipped`, so a
// session the day gates rejected drew nothing whatsoever -- and because the $8 Max OR Width gate rejects
// EVERY session on a symbol priced unlike TSLA, the chart came up completely blank with no indication of
// why. "The gate ate the whole history" and "there were no signals" looked identical. A skipped day now
// still draws its range, DIMMED and DOTTED, and the OR-High tag names the gate that rejected it and the
// number that failed -- so the chart answers the question instead of posing it.
//
// DRAWING ONLY. `daySkipped` still feeds `canTrade` exactly as before and no order path is touched; a
// skipped day has no entries because the LOGIC skipped it, which is the honest thing to show.
skipLine = daySkipped
dORH = skipLine ? color.new(color.aqua, 55) : cORH
dLBK = skipLine ? color.new(color.lime, 55) : cLBK
dSBK = skipLine ? color.new(color.red,  55) : cSBK
stOR = skipLine ? line.style_dotted : line.style_solid
stBK = skipLine ? line.style_dotted : line.style_dashed
if showLevels and isORbar and not na(orHigh)
    lnORH := line.new(bar_index, orHigh,   bar_index, orHigh,   color=dORH, width=2, style=stOR)
    lnORL := line.new(bar_index, orLow,    bar_index, orLow,    color=dORH, width=2, style=stOR)
    lnLBK := line.new(bar_index, longBrk,  bar_index, longBrk,  color=dLBK, width=1, style=stBK)
    lnSBK := line.new(bar_index, shortBrk, bar_index, shortBrk, color=dSBK, width=1, style=stBK)
    if showLvlLbl
        // On a skipped day the OR-High tag carries the REASON. Both gates can fire at once, so all three
        // cases are spelled out; rvol20 is guaranteed non-na inside skipVol, so it never prints NaN.
        skipWhy = not daySkipped ? "" : skipWide and skipVol ? "\nSKIPPED: OR $" + str.tostring(orWidth, "#.##") + " > max $" + str.tostring(maxORWidthS, "#.##") + " AND vol " + str.tostring(rvol20, "#.##") + "% > " + str.tostring(maxRvolPct, "#.##") + "%" : skipWide ? "\nSKIPPED: OR $" + str.tostring(orWidth, "#.##") + " > max $" + str.tostring(maxORWidthS, "#.##") : "\nSKIPPED: vol " + str.tostring(rvol20, "#.##") + "% > max " + str.tostring(maxRvolPct, "#.##") + "%"
        // the two trigger tags sit OUTSIDE the range and the two OR tags INSIDE it, so the pairs never collide
        tgORH := label.new(bar_index, orHigh,   "OR H " + str.tostring(orHigh, format.mintick) + skipWhy,   style=label.style_label_up,   color=dORH, textcolor=color.black, size=size.tiny)
        tgORL := label.new(bar_index, orLow,    "OR L " + str.tostring(orLow, format.mintick),    style=label.style_label_down, color=dORH, textcolor=color.black, size=size.tiny)
        tgLBK := label.new(bar_index, longBrk,  "LONG > " + str.tostring(longBrk, format.mintick), style=label.style_label_down, color=dLBK, textcolor=color.black, size=size.tiny)
        tgSBK := label.new(bar_index, shortBrk, "SHORT < " + str.tostring(shortBrk, format.mintick), style=label.style_label_up, color=dSBK, textcolor=color.white, size=size.tiny)

// extend today's segments (and drag their tags) to the newest bar of THIS session only
if showLevels and session.ismarket
    if not na(lnORH)
        line.set_x2(lnORH, bar_index)
    if not na(lnORL)
        line.set_x2(lnORL, bar_index)
    if not na(lnLBK)
        line.set_x2(lnLBK, bar_index)
    if not na(lnSBK)
        line.set_x2(lnSBK, bar_index)
    if not na(tgORH)
        label.set_x(tgORH, bar_index)
    if not na(tgORL)
        label.set_x(tgORL, bar_index)
    if not na(tgLBK)
        label.set_x(tgLBK, bar_index)
    if not na(tgSBK)
        label.set_x(tgSBK, bar_index)
plot(active ? stop : na, "Active Stop", color=color.red, linewidth=2, style=plot.style_linebr)
plot(active and not na(tp) ? tp : na, "Active TP", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(active and not beTrig and not na(beLevel) ? beLevel : na, "BE Trigger", color=color.new(color.yellow, 0), style=plot.style_circles)
plot(primStopped and not active ? (primDir == 1 ? orLow : orHigh) : na, "Reversal Trigger", color=color.new(color.purple, 0), linewidth=2, style=plot.style_circles)
bgcolor(daySkipped ? color.new(color.gray, 90) : na, title="Day skipped (vol regime / wide OR)")

// ---- PRIOR-DAY LEVELS (v3.9.4) — four distinct COLOURS *and* four distinct PATTERNS, per-day segments ----
//   PDH magenta thick solid | PDL blue thick solid | PDC white dotted | PDO orange dashed
cPDH = color.new(color.fuchsia, 0)
cPDL = color.new(color.rgb(41, 98, 255), 0)
cPDC = color.new(color.white, 0)
cPDO = color.new(color.orange, 0)
// v3.9.4: ONE SEGMENT PER DAY. The old plot(style_stepline) ran the whole chart width and drew a
// vertical riser at every session boundary, so yesterday's level bled into today. Now each session opens
// its own four lines on its first RTH bar, extends them only to its own last bar, and never touches the
// next day. Older sessions are deleted once `pdKeep` days are on screen so the 500-object caps are safe.
var line  lnPDH = na
var line  lnPDL = na
var line  lnPDC = na
var line  lnPDO = na
var label tgPDH = na
var label tgPDL = na
var label tgPDC = na
var label tgPDO = na
var line[]  pdLineHist = array.new_line()
var label[] pdTagHist  = array.new_label()

if showPD and isNewDay
    // retire yesterday's four segments (and their tags) into the bounded history ring
    if not na(lnPDH)
        array.push(pdLineHist, lnPDH)
    if not na(lnPDL)
        array.push(pdLineHist, lnPDL)
    if not na(lnPDC)
        array.push(pdLineHist, lnPDC)
    if not na(lnPDO)
        array.push(pdLineHist, lnPDO)
    if not na(tgPDH)
        array.push(pdTagHist, tgPDH)
    if not na(tgPDL)
        array.push(pdTagHist, tgPDL)
    if not na(tgPDC)
        array.push(pdTagHist, tgPDC)
    if not na(tgPDO)
        array.push(pdTagHist, tgPDO)
    while array.size(pdLineHist) > pdKeep * 4
        line.delete(array.shift(pdLineHist))
    while array.size(pdTagHist) > pdKeep * 4
        label.delete(array.shift(pdTagHist))
    // open today's four segments (zero length for now; extended bar by bar below)
    lnPDH := showPDH and not na(pdH) ? line.new(bar_index, pdH, bar_index, pdH, color=cPDH, width=2, style=line.style_solid) : na
    lnPDL := showPDL and not na(pdL) ? line.new(bar_index, pdL, bar_index, pdL, color=cPDL, width=2, style=line.style_solid) : na
    lnPDC := showPDC and not na(pdC) ? line.new(bar_index, pdC, bar_index, pdC, color=cPDC, width=1, style=line.style_dotted) : na
    lnPDO := showPDO and not na(pdO) ? line.new(bar_index, pdO, bar_index, pdO, color=cPDO, width=1, style=line.style_dashed) : na
    // small self-identifying tag, drawn ABOVE the line and carried along to its right end
    tgOn = showPDLbl
    tgPDH := tgOn and showPDH and not na(pdH) ? label.new(bar_index, pdH, "PDH " + str.tostring(pdH, format.mintick), style=label.style_label_down, color=cPDH, textcolor=color.white, size=size.tiny) : na
    tgPDL := tgOn and showPDL and not na(pdL) ? label.new(bar_index, pdL, "PDL " + str.tostring(pdL, format.mintick), style=label.style_label_down, color=cPDL, textcolor=color.white, size=size.tiny) : na
    tgPDC := tgOn and showPDC and not na(pdC) ? label.new(bar_index, pdC, "PDC " + str.tostring(pdC, format.mintick), style=label.style_label_down, color=cPDC, textcolor=color.black, size=size.tiny) : na
    tgPDO := tgOn and showPDO and not na(pdO) ? label.new(bar_index, pdO, "PDO " + str.tostring(pdO, format.mintick), style=label.style_label_down, color=cPDO, textcolor=color.black, size=size.tiny) : na

// extend today's segments (and drag their tags) to the newest bar of THIS session only
if showPD
    if not na(lnPDH)
        line.set_x2(lnPDH, bar_index)
    if not na(lnPDL)
        line.set_x2(lnPDL, bar_index)
    if not na(lnPDC)
        line.set_x2(lnPDC, bar_index)
    if not na(lnPDO)
        line.set_x2(lnPDO, bar_index)
    if not na(tgPDH)
        label.set_x(tgPDH, bar_index)
    if not na(tgPDL)
        label.set_x(tgPDL, bar_index)
    if not na(tgPDC)
        label.set_x(tgPDC, bar_index)
    if not na(tgPDO)
        label.set_x(tgPDO, bar_index)

// ==================== INFO TABLE ====================
var table t = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "UDB-ORB v3.9.16", text_color=color.white, bgcolor=color.rgb(30,30,50), text_size=size.small)
    table.cell(t, 1, 0, str.substring(profile, 0, 2), text_color=color.aqua, bgcolor=color.rgb(30,30,50), text_size=size.small)
    table.cell(t, 0, 1, "TP mode / Max Stop", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 1, tpModeSel + " / $" + str.tostring(maxCapSLS, "#.##"), text_color=color.aqua, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 2, "Today's TP dist", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 2, na(tpDist) ? "n/a" : "$" + str.tostring(tpDist, "#.##"), text_color=color.aqua, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 3, "RVol (gate " + (isNonTSLA ? "OFF - non-TSLA preset" : "≤ " + str.tostring(maxRvolPct, "#.##") + "%") + ")", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 3, na(rvol20) ? "n/a" : str.tostring(rvol20, "#.##") + "%", text_color=skipVol ? color.red : color.lime, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 4, "Today", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 4, daySkipped ? "SKIPPED" : "tradable", text_color=daySkipped ? color.red : color.lime, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 5, "$ scale (" + syminfo.ticker + ")", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 5, pxAutoOn ? "x" + str.tostring(pxScale, "#.###") + " vs $" + str.tostring(pxRef, "#") : "1.000 (off)", text_color=pxAutoOn ? color.aqua : color.silver, bgcolor=color.rgb(25,25,25), text_size=size.small)
