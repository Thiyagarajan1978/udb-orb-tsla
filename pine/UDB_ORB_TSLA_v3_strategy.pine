//@version=6
strategy("UDB-ORB TSLA v3.9.3 STRATEGY — A1/B1/C1/C2/D1 Profiles", shorttitle="UDB-ORB v3.9.3 S", overlay=true,
     process_orders_on_close = true,      // market orders fill at the SIGNAL BAR'S CLOSE (alerts-only realism)
     calc_on_every_tick      = false,
     pyramiding              = 0,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     initial_capital         = 10000,     // $10,000 retail account (default): 25 sh TSLA (~$400) ~= $10k, ~1x
     margin_long             = 0,
     margin_short            = 0,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0,
     slippage                = 0,          // Python charges $0.10/unit on exits; set TV ~10 ticks to match
     max_labels_count        = 500)

// v3.9.3 2026-08-09 — PRIOR-DAY LEVELS (PDH / PDL / PDC / PDO) ADDED, DIAGNOSTIC ONLY.
// Four new plots + an input group "Prior-Day Levels". NO order, entry, exit, stop, target, reversal,
// day-skip or webhook JSON reads them — the Strategy Tester result is byte-identical to v3.9.2.
// Purpose: eyeball whether ORB failures (BE stops especially — 87% of losses) cluster at a prior-day
// level, ahead of deciding whether any of them is worth turning into a real filter.
// LEGEND — four different colours AND four different patterns, so each is identifiable in a screenshot:
//     PDH = MAGENTA / fuchsia, thick SOLID step line     (prior day HIGH)
//     PDL = BLUE  #2962FF,     thick SOLID step line     (prior day LOW)
//     PDC = WHITE,             thin DOTTED (circles)     (prior day CLOSE)
//     PDO = ORANGE,            thin CROSS / x marks      (prior day OPEN)
// Right-edge tags re-use 4 label objects (moved, never re-created), so they are safe to leave on even
// with "Show Labels" OFF for a 365-day run — they cost 4 of the 500-label budget, permanently.
// PRIOR ART: the Python enhancement `pdh_pdl_filter` is BUILT and default OFF — it barely triggers on
// TSLA (docs/BE_STOP_ANALYSIS.md sect.6). PDC and PDO have never been tested in any form.
// Keep this file's version EQUAL to the indicator's — both moved to v3.9.3 together.
//
// v3.9.2 2026-08-09 — TWO DEFAULTS CHANGED (no logic change; both are input defaults only):
//   1. "Option expiration" +0 days -> "Friday (weekly)".  2. "Profile" C1 -> A1.
// WHY (options expiry audit, 2026-08-09, from the OPRA definition files themselves):
//   TSLA listed FRIDAY-ONLY expiries until 2026-02-02 (first Mon/Wed contract appeared in the
//   2026-01-26 snapshot). Cached definitions: 2025 = 49 Fri + 2 Thu (holiday weeks) and ZERO
//   Mon/Wed; 2026 = 24 Mon / 23 Wed / 36 Fri. So every options figure published for the
//   2025-01..2026-07 window was priced ~85% on FRIDAY contracts at 1-4 DTE — the "0DTE" label
//   on those numbers is a misnomer, and the old "weekly beats 0DTE by 3-5%" claim was comparing
//   a contract to ITSELF over most of the sample (tell-tale: D1 2025 dte0 +$3,560 vs wk +$3,570).
//   With 2026 data the two legs are finally distinct, and WEEKLY wins on 5 of 5 profiles in each
//   of 3 independent windows (2026 Jan-May, Jun-Jul17, and the forward ledger's 70 true-0DTE
//   trades, ~30% less loss there). "Friday (weekly)" also ALWAYS resolves to a listed contract on
//   any weekday; "+0 days" silently rolls to 1DTE on Tue/Thu because TSLA has no dailies.
//   PROFILE -> A1: best on options in BOTH priced windows and the only profile positive in the
//   flat Jan-May stretch. NOTE B1 is the WORST on options (-$1,116 Jan-May) though it is a
//   traded shares profile — the shares ranking and the options ranking are NOT the same.
// SIZE FOR THIS: the 2026 options edge is REGIME-CONCENTRATED, not a steady drip. Weekly, 1 ct,
//   barclose: Jan 2-May 31 (109 trades, 5 months) A1 +$785 / D1 +$462 / C1 -$316 / C2 -$387 /
//   B1 -$1,116 — i.e. the best profile made ~$7/trade on ~$656 of premium, indistinguishable
//   from zero. Jun 1-Jul 17 (34 trades) A1 +$7,743 (June alone +$6,635). 91% of 2026's options
//   P&L came from 34 of 143 trades, and the window after it (forward test) is negative.
//
// v3.9.1 2026-07-28 — DOCUMENTATION ONLY (no logic, no input, no order, no webhook change).
// Records a concept tested and REJECTED 2026-07-28, so it is not re-proposed from the chart:
// IMMEDIATE REVERSAL ON THE BE-STOP BAR — flip at the same 5m close the BE stop fills at, instead
// of waiting for a close back through the raw opposite OR boundary (the current rule). Asked from
// a live chart where the flip would have worked; built as the Python enhancement
// reversal_capture.immediate_on_be_stop (default OFF) and swept on ALL FIVE profiles.
// It roughly DOUBLES the reversal count (198 -> 374 over 5yr) while total reversal P&L FALLS
// (+145.6 -> +79.8/unit) — the ~176 extra flips are collectively net-negative. The best variant
// beat baseline on 2024-2026 WINDOW TOTALS in every profile (A1 +17.6, B1 +17.6, C1 +5.7,
// C2 +28.0, D1 +23.4) — but per YEAR it loses 2022, 2023 AND 2024 in every profile:
//   delta/unit vs base, sum of A1+B1+C1+C2+D1:
//   2022 -78.8 | 2023 -151.7 | 2024 -56.0 | 2025 +109.5 | 2026YTD +38.9   (2022-23 = true OOS)
// The whole "edge" is 2025. Trailing 2 months negative in all five (A1/B1/D1 -2.8, C1 -3.5,
// C2 -0.2); D1's 5yr maxDD degrades -56.1 -> -66.6. Same 2025-only regime signature that killed
// the midline-trigger reversal. Profile choice cannot rescue it: all five share ONE entry engine
// and differ only in the runner exit, so the flip lands on the identical set of BE-stop bars.
// DO NOT RE-ADD. The OR-break wait is a FILTER, not latency — crossing the whole range is what
// distinguishes a genuine failed breakout from chop INSIDE the range, and the reversal's own stop
// is only meaningful once price has crossed it. (Structural note: a BE-stop fill often lands
// inside/below the OR, which would put the normal reversal stop on the WRONG side of entry and
// let the risk-parity cap inflate size absurdly.)
// Reproduce: python scripts/immediate_reversal_test.py --profiles all --years [--windows|--detail]
// Full analysis: docs/BE_STOP_ANALYSIS.md §31.
// v3.9 2026-07-26 — ENTRY CUTOFF ADOPTED (default ON, 12:00): loss-anatomy on 5 years of trades
// showed post-noon entries are a net-NEGATIVE cohort (the 12:00-13:00 lunch hour is the toxic
// pocket; losing stops die in ~30min while winners run for hours). No NEW entries — primary or
// reversal — after 12:00; open positions still manage to their normal exits. Verified on
// A1/B1/C1/D1 incl 2022-23 OOS: WR up in every tested year-cell, net +3-4% (B1 5yr +463.4 vs
// +450.7/unit), worst day never worse (2025's improves). Python twin: enhancements.time_window
// {start 09:35, end 12:00} enabled in the A1/B1/C1/D1 + default yamls. Same-day knob re-sweep:
// stop cap $5, BE trigger 0.55, BE trail $0.25 all confirmed optimal.
// v3.8 2026-07-25 — OPTION QUANTITY MODE (enables the +49-63% fixed-DOLLAR sizing finding): new
// "Option quantity mode" input. "Fixed contracts" (default) = unchanged. "TradersPost sizing" =
// the options entry JSON OMITS the quantity field so TradersPost's strategy-level position sizing
// ("Amount per position" ~$1,100 + max-qty cap ~4) computes contracts from the premium — the
// 2026-07 analysis: fixed-$ sizing beat fixed 2ct by +49-63% (A1 +$42,093 vs +$25,790) with lower
// premium at risk. VERIFY IN PAPER first that TradersPost divides by the option PREMIUM for
// options (docs don't say); exits unaffected. Mid-price ENTRY LIMITS were fill-simulated same day
// and REFUTED (adverse selection: missed winners > all spread savings) — entries stay MARKET.
// v3.7 2026-07-24 — CONFIGURABLE SHARE QUANTITY (user request, mirrors the Option-contracts input):
// the "Shares per 'unit'" input is RENAMED "Share quantity (Shares mode, per 1.0-unit trade)" —
// set your fixed share size there once; every order and webhook JSON quantity = Units Per Trade x
// this (default 1.0 x 25 = 25 sh; the risk-parity reversal scales off it and may exceed it up to
// the $-risk cap). Same-named input added to the v3.7 INDICATOR (its entry/reversal/partial alerts
// now carry the exact share count; table adds a "Net @ N sh" dollar row) — keep the two inputs
// EQUAL. No trade-logic change; sizing default (25) unchanged.
// v3.6 2026-07-23 — D1 EXIT MODE OPTION (user request, like the C2 formula input): new "D1 Exit
// mode" input — "Partial TP + ATR Trail" (default, the original D1) vs "FULL EXIT AT ATR TRAIL":
// nothing is taken at the adaptive TP (its touch only ARMS the trail; no TP order is placed),
// 100% exits on the TRADE TASTIC flip — ONE exit alert/order, so it also suits platforms that
// cannot split exits. Tested (per unit, fixed trail, close-stop) full-trail vs partial:
// 2024 +39.7 vs +38.4 | 2025 +85.2 vs +72.2 | 2026YTD +179.0 vs +162.3 -> full-trail wins ALL
// THREE (3yr +304 vs +273; B1 ref +268), 2025 worst day -13.6 vs -12.0, ~1pt lower WR.
// Python twin: tsla_config_D1.yaml with partial_qty_pct: 0.0.
// v3.5 2026-07-23 — C2 TAKE-PROFIT FORMULA CHANGED (user request): C2's target is now the OPEN
// BAR's High - Low (= OR width, no floor/scale) instead of the fixed $2. Per unit, close-stop,
// OR-width vs fixed-$2: 2022 +29.7 vs +42.9 | 2023 +82.3 vs +88.8 | 2024 +36.6 vs -23.1 |
// 2025 +38.3 vs -0.3 | 2026YTD +111.7 vs +49.0  => 5yr +298.6 vs +157.3 (~2x), POSITIVE EVERY
// YEAR (the fixed $2 was net-NEGATIVE 2024 and flat 2025 under the close stop). WR drops
// (46-50% vs 50-63%). The old behavior stays selectable: "C2 Take-Profit formula" = Fixed $.
// v3.4 2026-07-23 — D1 SHORT-SIDE FIX (user-caught same day on the live chart): the original
// TRADE TASTIC script has ONE line — a SHORT must exit on the red->green flip of the SAME
// HHV(high - mult*ATR) line, not on an invented mirrored LLV(low + mult*ATR) line. On 2026-07-23's
// short the true flip was 10:35 (close 324.30 > TS 319.48); the mirror exited 11:55. Fixed here,
// in the v3.4 indicator, and in the Python engine (single-line everywhere; longs unchanged).
// CORRECTED numbers, per unit, D1 vs B1: 2024 +38.4 vs +20.2 | 2025 +72.2 vs +102.8 |
// 2026YTD +153.9 vs +138.0 -> 3yr ~tie (+264 vs +261). Still experimental / NOT adopted.
// v3.3 2026-07-23 — NEW PROFILE D1 (experimental, for side-by-side comparison — NOT adopted):
// D1 = B1's engine (Adaptive TP + 25% partial) with the "TRADE TASTIC" ATR TRAIL as the runner
// exit instead of the VWAP cross. Python twin: config/tsla_config_D1.yaml (atr_trail_exit).
// (v3.3's short side + numbers were the buggy mirror — superseded by the v3.4 fix above.)

// v3.2 2026-07-23 — PARTIAL-AS-ORDER OPTION (no trade-logic change): new Shares-mode input "Partial exit
// as opposite-side order". Some execution platforms treat action=exit as FLATTEN-ALL and ignore the
// quantity, so the 25% partial's '{"action":"Exit","quantity":N}' closed the whole position. ON sends the
// partial as a plain opposite-side order instead — long -> '{"action":"Sell","quantity":N}', short ->
// '{"action":"Buy","quantity":N}' — so a netting platform reduces the position by N. The runner / stop /
// VWAP / EOD exits still send full "Exit". REQUIRES a platform that NETS an opposite-side order against
// the open position (reduces); if yours REVERSES (closes all + opens the other way), leave this OFF.
// Verify one partial fill in paper before trusting it live. Default OFF (TradersPost exit honors quantity).
// v3.1 2026-07-21 — OPTIONS ALERT FIX (no trade-logic change): in Options mode the 25% partial's
// suppressed webhook used alert_message=na, so TradingView fired the fill alert with the LITERAL text
// "{{strategy.order.alert_message}}" (an unset alert_message leaves the placeholder unresolved — seen
// live on the B1 Options alert 2026-07-21 10:45, the Partial@TP fill). It now sends an explicit
// human-readable "no action" text that TradersPost ignores; every order now carries an alert_message.
// STATUS 2026-07-19 — CORRECTED 2026-07-24: the rival "3-bot" concept's TSLA result (+$45,916 @1ct)
// was ENTIRELY the bar-START pricing lookahead; barclose-corrected it is NEGATIVE on TSLA (BOT1
// -$2,295 @1ct 2022-26, all spread bots negative) — UDB stays the TSLA system, now unambiguously.
// TSLA credit spreads tested and rejected (thin credits vs $2.50 strikes, weekly expiry). Every weekday is
// net-positive; FRIDAY is the best options day (74% WR, true 0DTE) — never skip it. Options paper trading:
// per-contract risk ~= HALF the premium (median ~$435/ct); prefer fixed-DOLLAR sizing over fixed contracts
// (cheap-premium entries carry PF ~6 vs ~2.5 on rich ones). SPX system = SEPARATE SPX_ORB_3BOT_v1 files;
// both forward ledgers (TSLA forward_test.py + SPX forward_test_spx.py) run daily via the 9AM task.
// STATUS 2026-07-14: ONE strategy, FOUR selectable profiles (the "Profile" input). TSLA 5-minute, RTH,
// OR start 09:30 (selectable). DEFAULT = $10,000 account, 25 shares/unit (~1x unleveraged on TSLA). All
// share the SAME entry engine, ADOPTED close-triggered stops (Stop trigger 'Close'), vol/OR gates, risk-parity
// reversal, confirmation OFF. They differ ONLY in the exit:
//   A1 = Adaptive TP + 25% partial + PEAK-TRAIL runner        (Max Stop $5)
//   B1 = Adaptive TP + 25% partial + VWAP-CROSS runner        (Max Stop $5)
//   C1 = ATR-target (0.25 x 14d ATR) + 25% partial + VWAP     (Max Stop $6)   <- best PF
//   C2 = OR-WIDTH target (open bar H-L), FULL exit (no partial/runner) (Max Stop $5) [was fixed $2 pre-v3.5]
//
//  EXECUTION MODEL — proper OCO brackets (all fills intrabar at the level / open-on-gap = touch):
//   * C2 (full exit): ONE strategy.exit("X", stop=, limit=) — whole position at stop OR target.
//   * A1/B1/C1 (partial+runner): "P1" = the 25% partial as an OCO(stop+target), "RUN" = the 75%
//     remainder on the stop (peak-trail A1 / VWAP-close B1,C1). BOTH legs carry a stop, so a stop-out
//     closes 100% (the earlier bug let a limit-only leg ride to EOD). Reversal arms only on a stop-out
//     before any partial (state part1/tpWasHit). See BE_STOP_ANALYSIS + memory (2026-07-13 TV fix).
//
//  SHARES PER UNIT (default 25 = ~$10k on TSLA): the reversal is risk-parity sized and needs FRACTIONAL
//  units (e.g. 1.59); at 1 share/unit that rounds to 1 and the cap vanishes. With 25, 1.59 units = ~40 sh.
//  ==> Strategy Tester P&L = 25x the Python per-unit figures (= the @100-share reports / 4). The 2x
//  reversal can momentarily hold ~2x notional; margin_long/short are left 0 so it isn't rejected on $10k.
//
//  DEFAULT $10,000 / 25-SHARE RESULTS (FULL 2022-2026, ADOPTED close-triggered stop = Stop trigger 'Close'):
//    Profile   Net$      %ret   PF    WR    MaxDD$   %DD    WorstDay      (Strategy Tester = per-unit x25)
//    A1        +10,817   +108%  1.22  48%   -1,562   -16%   -300
//    B1        +11,258   +113%  1.23  47%   -1,856   -19%   -300         (max net)   <- USER TRADES B1
//    C1        +10,371   +104%  1.22  48%   -1,937   -19%   -332         (best PF/DD balance) <- and C1
//    C2        +4,383    +44%   1.12  57%   -1,673   -17%   -300         (high WR, lowest net; drives OPTIONS)
//  ADOPTED 2026-07-14 - STOP fires only when the bar CLOSES beyond the level (default 'Close'): +42-46% net
//    vs the old wick/resting stop, ~40% smaller drawdown, and 2024 FLIPS from a loss to a profit. The TP
//    still fills on a favorable wick. Walk-forward OOS-confirmed: 2022 & 2023 (never part of discovery)
//    both +$3.4-5.9k @100. Flip Stop trigger -> 'Wick' for the OLD any-touch resting stop (then beRealistic).
//  RECONCILE: Strategy Tester net = Python per-unit x 25  (= the @100-share validation reports / 4).
//  A stop-exit (Base SL / BE Stop / BE Trail) MUST appear in every profile & cap near Max Stop ($5/$6).
//  Size off 2024 (was a losing year, now marginally green), NEVER off the flattering 2026.
//  READ: B1 = raw-net leader, C1 = near-equal net with the best PF/DD balance. Both are what the user trades.
//  A1 = dominated by B1/C1. C2's 57% WR is a mirage (lowest net, WORST drawdown, most losing months -
//  it caps winners at $2 but still eats full stops). Every profile is positive in all 5 years.
//=============================================================================================

// ==================== PROFILE ====================
profile = input.string("A1 · Adaptive + Peak-Trail", "Profile",
     options=["A1 · Adaptive + Peak-Trail", "B1 · Adaptive + VWAP", "C1 · ATR 0.25 + 25% Partial + VWAP", "C2 · OR-Width Full-Exit", "D1 · Adaptive + ATR-Trail (exp)"],
     group="Profile", tooltip="A1/B1 = adaptive OR-scaled target + 25% partial + runner (peak-trail vs VWAP). C1 = ATR-sized target + 25% partial + VWAP (best PF). C2 = full exit at OR-WIDTH target (open bar H-L; was fixed $2 pre-v3.5), no partial/runner. D1 (EXPERIMENTAL, not adopted) = B1 with the TRADE TASTIC ATR trail as the runner exit.")
c2TPFormula = input.string("OR width (open bar High-Low)", "C2 Take-Profit formula", options=["OR width (open bar High-Low)", "Fixed $"], group="Profile", tooltip="ADOPTED v3.5 (default): C2's target = the OPEN BAR's High - Low (= OR width, no floor). vs the old fixed $2 (per unit, close-stop): 2024 +36.6 vs -23.1, 2025 +38.3 vs -0.3, 2026YTD +111.7 vs +49.0; 2022/23 slightly behind; 5yr ~2x and positive every year. 'Fixed $' = the pre-v3.5 C2 (uses the Fixed TP $ input).")
d1ExitMode = input.string("Full exit at ATR Trail", "D1 Exit mode", options=["Full exit at ATR Trail", "Partial TP + ATR Trail"], group="Profile", tooltip="D1 only. 'Full exit at ATR Trail' (DEFAULT since 2026-07-23; the Python forward test tracks it) = NOTHING is taken at the TP — its touch only ARMS the trail; 100% exits on the flip (ONE exit alert/order — also suits platforms that cannot split exits). 'Partial TP + ATR Trail' = the original D1: 25% off at the adaptive TP, 75% rides the flip. v3.6 test (per unit, fixed trail): full-trail beats the partial in all of 2024/25/26 (+39.7/+85.2/+179.0 vs +38.4/+72.2/+162.3) at a slightly deeper 2025 worst day (-13.6 vs -12.0).")
isA1 = str.startswith(profile, "A1")
isB1 = str.startswith(profile, "B1")
isC1 = str.startswith(profile, "C1")
isC2 = str.startswith(profile, "C2")
isD1 = str.startswith(profile, "D1")
tpModeSel  = isC2 ? (str.startswith(c2TPFormula, "Fixed") ? "Fixed" : "ORw") : isC1 ? "ATR" : "Adaptive"
d1FullTrail = isD1 and str.startswith(d1ExitMode, "Full")   // D1 full-trail: TP touch only arms; 100% exits on the flip
usePartial = not isC2                 // C2 is a full exit; A1/B1/C1/D1 scale out 25% (D1 full-trail: 0%)
runnerVWAP = isB1 or isC1             // true = VWAP-cross runner ; false = peak-trail (A1) or ATR trail (D1)

// ==================== INPUTS ====================
grpS = "Session"
eodHour = input.int(15, "EOD Exit Hour", minval=0, maxval=23, group=grpS)
eodMin  = input.int(50, "EOD Exit Minute", minval=0, maxval=59, group=grpS)
orStart = input.string("09:30", "Opening Range start bar", options=["09:30", "09:45"], group=grpS, tooltip="09:30 = classic first-bar OR. 09:45 = skip the noisy opening 15 min (better 2024/25 backtest, WORSE 2026).")
entryCutOn = input.bool(true, "Entry cutoff — no NEW entries after the time below", group=grpS, tooltip="ADOPTED 2026-07-26 (default ON, 12:00): entries after noon were a net-NEGATIVE cohort in 5 years of trade data — the damage concentrates in the 12:00-13:00 lunch hour. Blocking NEW entries (primary AND reversal; open positions still manage to their normal exits) after 12:00: WR up in all 7 tested year-cells on B1/D1 (+A1/C1 confirmed), net +3-4% (B1 5yr +463 vs +451/unit), worst day never worse, 2025's improves. OFF = trade all day (pre-cutoff behavior).")
entryCutH  = input.int(12, "Entry Cutoff Hour", minval=9, maxval=15, group=grpS)
entryCutM  = input.int(0,  "Entry Cutoff Minute", minval=0, maxval=59, group=grpS)

grpR = "Risk / Regime Gates"
maxORWidth  = input.float(8.0,  "Max OR Width ($) — skip wider days", step=0.5, group=grpR)
volLookback = input.int(20,     "Volatility Lookback (days)", minval=2, group=grpR)
maxRvolPct  = input.float(4.92, "Max Prior Realised Daily Vol (%)", step=0.01, group=grpR)

grpE = "Entry"
bufferPctOR = input.float(10.0, "Breakout Buffer (% of OR width)", step=0.5, group=grpE)
tradeQty    = input.float(1.0,  "Units Per Trade", minval=0.01, group=grpE)
shareQty    = input.int(25,     "Share quantity (Shares mode, per 1.0-unit trade)", minval=1, group=grpE, tooltip="v3.7 (was 'Shares per unit'): your FIXED share size, configured here like the Option-contracts input. Every order and webhook JSON quantity = Units Per Trade x this (default 1.0 x 25 = 25 sh, ~$10k unleveraged on TSLA); the risk-parity REVERSAL scales off it (can exceed it up to ~2x before the $-risk cap; margin_long/short are 0 so it isn't rejected). Strategy Tester P&L = this x the Python per-unit figures. Keep EQUAL to the indicator's 'Share quantity' input.")

grpX = "Exit tuning (which apply depends on the Profile)"
maxCapOverride  = input.float(0.0,  "Max Stop override ($, 0 = use profile: C1=6 else 5)", step=0.5, group=grpX)
adaptiveTPScale = input.float(1.0,  "Adaptive TP — OR Width Multiplier (A1/B1)", step=0.05, group=grpX)
adaptiveTPMin   = input.float(2.14, "Adaptive TP — Minimum Floor $ (A1/B1)", step=0.01, group=grpX)
atrTPMult       = input.float(0.25, "ATR TP Multiplier x 14d ATR (C1)", step=0.01, group=grpX)
atrTPMin        = input.float(1.0,  "ATR TP Floor $ (C1)", step=0.25, group=grpX)
atrPeriod       = input.int(14,     "ATR Period (daily bars, C1)", minval=2, group=grpX)
fixedTP         = input.float(2.0,  "Fixed TP $ (C2)", step=0.25, group=grpX)
beTrigger       = input.float(0.55, "BE Retrace Trigger (% of OR width)", step=0.05, group=grpX)
beTrailAmt      = input.float(0.25, "BE Trail Amount ($)", step=0.01, group=grpX)
beRealistic     = input.bool(true,  "Realistic resting stop: a BE-retrace can't protect its own firing bar (Wick mode only)", group=grpX, tooltip="Only matters in Wick stop mode. ON = the stop moved to break-even rests from the NEXT bar (a bar firing BE-retrace AND hitting base SL fills at base SL). OFF = old optimistic look-ahead.")
stopTrigger     = input.string("Close (bar closes beyond)", "Stop trigger", options=["Close (bar closes beyond)", "Wick (any touch)"], group=grpX, tooltip="ADOPTED 2026-07-14 (default Close): the STOP fires only when the bar CLOSES beyond the level and flattens at the close — skips wick fakeouts (+42-46% net / DD -40% over 2022-26, flips 2024 positive; walk-forward OOS-confirmed). The TP stays a resting limit (favorable wick fill). Wick = the old resting stop (any touch fills at the level; beRealistic then applies).")
stopClose = str.startswith(stopTrigger, "Close")
partialPct      = input.float(25.0, "Partial Exit Quantity % (A1/B1/C1)", step=1.0, group=grpX)
runnerMult      = input.float(0.75, "Runner Peak-Trail x OR width (A1)", step=0.05, group=grpX)
vwapArmProfit   = input.float(1.0,  "VWAP Cross — arm after profit $ (B1/C1)", step=0.25, group=grpX)
ttAtrPeriod     = input.int(5,      "ATR Trail — ATR Period (D1)", minval=1, group=grpX)
ttHhvPeriod     = input.int(10,     "ATR Trail — HHV/LLV Period (D1)", minval=1, group=grpX)
ttMult          = input.float(2.5,  "ATR Trail — ATR Multiplier (D1)", step=0.1, group=grpX, tooltip="D1 runner exit = the 'TRADE TASTIC' chandelier: line = HHV(high - mult*ATR(period), hhv) for longs (mirrored for shorts); moves only on a bar that CLOSES beyond it AND extends (close > prev close); the runner flattens when a bar CLOSES across the line. Mult sweep 1.5-3.5 tested 2026-07-23: no setting wins 2024+2025+2026 together.")

grpC = "Entry Confirmation"
confirmBreakout    = input.bool(false, "Require confirmation candle (2-candle break)", group=grpC, tooltip="DEFAULT OFF: net-negative under the resting stop.")
requireTrendCandle = input.bool(true,  "Confirmation candle must be with-trend", group=grpC)

grpV = "Reversal"
revQtyMult = input.float(2.0, "Reversal Size Multiplier (before risk cap)", step=0.5, group=grpV)
revRiskCap = input.float(6.0, "Reversal Dollar-Risk Cap ($, 0=off)", step=0.5, group=grpV)

grpO = "Options via TradersPost (webhook)"
orderAsset     = input.string("Shares", "Order asset", options=["Shares", "Options"], group=grpO, tooltip="Shares = the stock JSON (Buy/Sell/Exit, rounded shares). Options = TradersPost options JSON: a LONG signal buys a CALL, a SHORT signal buys a PUT, any full exit closes. WORKS ON ALL PROFILES incl A1/B1/C1: in Options mode the 25% partial's webhook is SUPPRESSED, so the single contract HOLDS through the partial and closes only at the runner's final exit (VWAP / trail / BE / close-stop / EOD) — matching the real 0DTE option backtest (A1/B1/C1 >> C2 on options). The Strategy Tester still shows the SHARE-signal P&L; real option P&L (delta/theta/IV) is NOT backtestable here. The suppressed partial fires an informational text alert ('NO OPTIONS ACTION ... contract holds') that TradersPost ignores (harmless).")
optContracts   = input.int(2,        "Option contracts (quantity)", minval=1, group=grpO, tooltip="DEFAULT 2. The real 0DTE backtest figures are PER CONTRACT, so 2 contracts = 2x P&L AND 2x premium at risk (~$465/ct -> ~$930/trade on TSLA, ~9% of a $10k account). Losses are capped small (~-$97/ct). Raise/lower to your risk tolerance.")
optExpiration  = input.string("Friday (weekly)", "Option expiration", options=["Friday (weekly)", "+0 days", "+1 days", "+2 days", "+3 days", "+7 days"], group=grpO, tooltip="DEFAULT since v3.9.2 (2026-08-09) = 'Friday (weekly)': computes days-to-Friday DYNAMICALLY each day (Mon +4 .. Fri +0), so it ALWAYS resolves to a listed contract on any weekday, and it is the leg the whole published options history was actually priced on. WHY IT CHANGED: TSLA listed FRIDAY-ONLY expiries until 2026-02-02, so the 2025-01..2026-07 '0DTE' figures were ~85% Friday contracts at 1-4 DTE — the old 'weekly beats 0DTE by 3-5%' claim compared a contract to itself. On 2026 data, where the two legs are finally distinct, WEEKLY wins on 5 of 5 profiles in 3 independent windows (Jan-May, Jun-Jul, and the forward ledger's 70 true-0DTE trades ~30% less loss). COST: ~22% more premium per contract. '+0 days' = nearest listed on/after today: true 0DTE on Mon/Wed/Fri but it silently rolls to 1DTE on Tue/Thu because TSLA has NO daily expiries (unlike SPX). The fixed '+2'/'+3 days' hit Friday only early in the week and roll into NEXT week from Wed on — manual experiments only.")
optStrikesAway = input.int(0,        "Strikes away from ATM (0 = ATM)", minval=0, group=grpO)
optQtyMode     = input.string("Fixed contracts", "Option quantity mode", options=["Fixed contracts", "TradersPost sizing (omit quantity)"], group=grpO, tooltip="Fixed contracts (default) = the webhook sends the 'Option contracts' quantity. 'TradersPost sizing' = the entry JSON OMITS the quantity field so TradersPost's strategy-level position sizing decides the contract count — set 'Amount per position' ~$1,100 there (+ a max-quantity cap ~4 if available). WHY: the 2026-07 analysis found fixed-DOLLAR sizing (contracts = floor($1,100/premium), cap 4, skip if unaffordable) beats fixed 2ct by +49-63% with LOWER premium at risk — cheap-premium days carry the edge. VERIFY IN PAPER FIRST: TradersPost's docs don't state whether 'Amount per position' divides by the option PREMIUM (correct) or the underlying price (wrong) for options — watch one fill's contract count before trusting it. Exits are unaffected (action=exit closes the whole position).")
optQtyFixed    = str.startswith(optQtyMode, "Fixed")
partialAsOrder = input.bool(false,   "Partial exit as opposite-side order (Shares mode)", group=grpO, tooltip="For platforms where action=exit ALWAYS flattens the whole position and ignores the quantity (cannot split). ON: the 25% partial fires as a plain opposite-side order — long -> action=Sell qty N, short -> action=Buy qty N — so a NETTING platform reduces the position by N and the 75% runner keeps riding. The runner/stop/VWAP/EOD exits still send the normal full 'Exit'. WARNING: only works if your platform NETS an opposite-side order against the open position; if it REVERSES (flatten + open opposite), leave OFF. Designed for the default Close stop mode; in Wick mode a stop-out day sends Sell-partial + Exit back-to-back (still ends flat). Test one partial fill in paper first. OFF = the original Exit-with-quantity JSON (TradersPost honors it).")

// ---- WEBHOOK ALERTS: per-order JSON via alert_message. In TradingView set the alert message to
// {{strategy.order.alert_message}} (NOT {{strategy.order.action}} — that only outputs buy/sell, never "Exit").
//   Shares  : action Buy (long entry) / Sell (short entry) / Exit (any close); quantity = ROUNDED whole shares.
//   Options : TradersPost — long->BUY CALL, short->BUY PUT (always action=buy; optionType carries direction),
//             full-exit->"exit"; contracts + 0DTE ATM via inputs. Leave "Invert puts" UNCHECKED in TradersPost.
//             WORKS ON ALL PROFILES: the 25% partial's webhook is auto-suppressed so 1 contract HOLDS to the
//             runner exit. BARCLOSE-CORRECTED 2026-07-20 (old figures carried a 5-min entry lookahead):
//             @1ct barclose 2025-01..2026-07-17 (UPDATED 2026-07-25, incl D1 + OR-width C2):
//             A1 +$12.9k / D1 +$11.3k / B1 +$11.2k / C1 +$10.1k / C2 +$4.2k (the v3.5 OR-width TP
//             flipped C2 positive; old fixed-$2 C2 was -$1k). 2026 YTD: A1 +$9.0k > D1 +$7.5k > B1 +$5.8k.
//             ^ READ AS **WEEKLY**, NOT 0DTE: TSLA had FRIDAY-ONLY expiries until 2026-02-02, so ~85% of
//             that window could only ever be priced on Friday contracts (1-4 DTE). See the v3.9.2 note.
//             EXPIRY: on 2026 data (where 0DTE contracts actually exist) WEEKLY beats true-0DTE on 5 of 5
//             profiles in 3 independent windows, at ~22% more premium. TSLA lists only ~Mon/Wed/Fri expiries
//             (SPX is daily) and TradersPost '+N days' = nearest listed on/after today+N, so a FIXED offset
//             cannot target Friday: 'Friday (weekly)' computes the +N dynamically. DEFAULT since v3.9.2.
//             CONCENTRATION WARNING: 91% of 2026's options P&L is Jun-mid-Jul (34 of 143 trades). Jan-May
//             2026 weekly @1ct: A1 +$785 only, and B1/C1/C2 NEGATIVE. Size for five flat months.
// 'Friday (weekly)' -> days until this week's Friday, else the dropdown string verbatim.
f_expStr() =>
    if optExpiration == "Friday (weekly)"
        int dtf = dayofweek.friday - dayofweek(time, "America/New_York")   // Mon..Fri -> 4..0
        "+" + str.tostring(math.max(dtf, 0)) + " days"
    else
        optExpiration
f_msg(act, q) =>
    string out = na
    if orderAsset == "Options"
        if act == "Exit"
            out := '{"ticker":"{{ticker}}", "action":"exit"}'
        else
            // Always BUY-to-open: direction is carried by optionType (call/put). TradersPost treats an
            // explicit put contract with action=sell as SELL-TO-OPEN a short put (unless the opt-in
            // "Invert puts" strategy setting is enabled) — leave "Invert puts" UNCHECKED with these signals.
            ot = act == "Buy" ? "call" : "put"
            // v3.8: in "TradersPost sizing" mode the quantity field is OMITTED so the TradersPost
            // strategy-level position sizing (e.g. "Amount per position" dollar budget) decides the
            // contract count — the July analysis showed fixed-DOLLAR sizing beats fixed contracts
            // +49-63%. An explicit quantity in the JSON would override it, hence the omission.
            qpart = optQtyFixed ? '"quantity":' + str.tostring(optContracts) + ', ' : ''
            out := '{"ticker":"{{ticker}}", "action":"buy", ' + qpart + '"expiration":"' + f_expStr() + '", "optionType":"' + ot + '", "strikesAway":' + str.tostring(optStrikesAway) + '}'
    else
        out := '{"ticker":"{{ticker}}", "action":"' + act + '", "quantity":' + str.tostring(q, "#") + ', "price":"{{close}}"}'
    out

grpU = "Display"
showLabels = input.bool(false, "Show Labels", group=grpU, tooltip="Turn OFF for 30/90/365-day runs (TradingView caps labels at 500).")
showLevels = input.bool(true, "Show Levels", group=grpU)

grpP = "Prior-Day Levels (PDH / PDL / PDC / PDO)"
showPD    = input.bool(true, "Show prior-day levels", group=grpP, tooltip="DIAGNOSTIC ONLY (v3.9.3): these four lines are DRAWN, never traded — no entry, exit, stop, target, day-skip or webhook rule reads them, so turning them on cannot change a single Strategy Tester trade. They are yesterday's completed RTH daily bar (Open/High/Low/Close) held flat across today. LEGEND: PDH = MAGENTA thick solid, PDL = BLUE thick solid, PDC = WHITE dotted, PDO = ORANGE x-marks.")
showPDLbl = input.bool(true, "Label each level at the right edge", group=grpP, tooltip="Draws 'PDH 331.20' style tags at the current bar. Uses 4 label objects that are MOVED, never re-created — safe to leave ON even with 'Show Labels' OFF for a 365-day run.")
showPDH   = input.bool(true, "PDH — prior day HIGH (magenta, solid)", group=grpP)
showPDL   = input.bool(true, "PDL — prior day LOW (blue, solid)", group=grpP)
showPDC   = input.bool(true, "PDC — prior day CLOSE (white, dotted)", group=grpP)
showPDO   = input.bool(true, "PDO — prior day OPEN (orange, x-marks)", group=grpP)

maxCapSL = maxCapOverride > 0 ? maxCapOverride : (isC1 ? 6.0 : 5.0)

// ==================== "TRADE TASTIC" ATR TRAIL (D1 runner exit) ====================
// ONE line for BOTH directions, exactly the original script: TS = HHV(high - mult*ATR, hhv);
// it MOVES only on a bar that closes above the HHV AND extends (close > prev close) — else it
// holds. Color = close > TS. LONG runner exits on green->red (close <= TS); SHORT runner exits
// on red->green (close > TS) — after a waterfall the falling HHV drags the accepted level down,
// which is how the line comes back under price to catch the cover flip (2026-07-23: flip 10:35
// where the removed "mirror" line exited 11:55). First 16 bars pin to the close (script warm-up).
ttATR = ta.rma(ta.tr(true), ttAtrPeriod)
ttHHV = ta.highest(high - ttMult * ttATR, ttHhvPeriod)
var float ttTS = na
if bar_index < 16
    ttTS := close
else
    ttTS := close > ttHHV and close > close[1] ? ttHHV : ttTS

// ==================== PRIOR-DAY VOL + DAILY ATR (no repaint) ====================
f_priorRvol() =>
    r = ta.change(close) / close[1] * 100.0
    s = ta.stdev(r, volLookback, false)
    s[1]
rvol20 = request.security(syminfo.tickerid, "D", f_priorRvol(), lookahead=barmerge.lookahead_on)
f_priorATR() =>
    a = ta.sma(ta.tr(true), atrPeriod)
    a[1]
dailyATR = request.security(syminfo.tickerid, "D", f_priorATR(), lookahead=barmerge.lookahead_on)

// ==================== PRIOR-DAY LEVELS (PDH/PDL/PDC/PDO) — DIAGNOSTIC, NOT TRADED ====================
// Yesterday's completed daily bar, held flat across today. Taking [1] INSIDE the request and pairing
// it with lookahead_on is the standard non-repainting idiom (identical to the rvol/ATR calls above):
// it returns the LAST CLOSED daily bar, so today's still-forming O/H/L/C can never leak in.
f_pdLevels() =>
    [open[1], high[1], low[1], close[1]]
[pdO, pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", f_pdLevels(), lookahead=barmerge.lookahead_on)

// ==================== STATE ====================
var float orHigh = na
var float orLow = na
var float orWidth = na
var bool skipVol = false
var bool skipWide = false
var bool daySkipped = false
var bool firstTaken = false
var bool active = false
var int tdir = 0
var float entry = na
var float stop = na
var float tp = na
var int entryBar = na
var bool inRev = false
var bool suppressPartial = false
var string entryId = ""
var bool beTrig = false
var float beLevel = na
var float qtyTotal = na
var float posSh = na          // ROUNDED share count of the current position (whole shares for the webhook)
var bool part1 = false
var bool tpWasHit = false
var float runnerPeak = na
var bool vwapArmed = false
var bool lastWasTrail = false   // A1: was the last-placed runner stop the PEAK-TRAIL (reason "Trail",
                                // does NOT arm) vs the BE/base stop (arms)? mirrors engine stop-first order.
var int primDir = 0
var bool primStopped = false

// ==================== NEW DAY / OPENING RANGE ====================
isNewDay = session.isfirstbar_regular
isORbar = orStart == "09:45" ? (hour == 9 and minute == 45) : isNewDay
sessVwap = ta.vwap(hlc3, isNewDay)
isEODbar = (hour * 60 + minute) >= (eodHour * 60 + eodMin)
isLastBar = session.islastbar_regular
isFlattenBar = isEODbar or isLastBar

if isNewDay
    orHigh := na
    orLow := na
    orWidth := na
    daySkipped := false
    firstTaken := false
    active := false
    tdir := 0
    entry := na
    stop := na
    tp := na
    entryBar := na
    inRev := false
    suppressPartial := false
    entryId := ""
    beTrig := false
    beLevel := na
    qtyTotal := na
    part1 := false
    tpWasHit := false
    runnerPeak := na
    vwapArmed := false
    primDir := 0
    primStopped := false

if isORbar
    orHigh := high
    orLow := low
    orWidth := high - low
    skipVol := not na(rvol20) and rvol20 > maxRvolPct
    skipWide := orWidth > maxORWidth
    daySkipped := skipVol or skipWide

longBrk = not na(orHigh) ? orHigh + orWidth * bufferPctOR / 100.0 : na
shortBrk = not na(orLow) ? orLow - orWidth * bufferPctOR / 100.0 : na
// target distance by profile: Fixed (C2) / ATR (C1) / Adaptive OR-scaled (A1/B1)
tpDist = tpModeSel == "Fixed" ? fixedTP : tpModeSel == "ORw" ? orWidth : tpModeSel == "ATR" ? (not na(dailyATR) ? math.max(atrTPMin, atrTPMult * dailyATR) : fixedTP) : (not na(orWidth) ? math.max(adaptiveTPMin, orWidth * adaptiveTPScale) : na)
canTrade = session.ismarket and not isORbar and not daySkipped and not na(orHigh) and not isFlattenBar and (not entryCutOn or hour * 60 + minute <= entryCutH * 60 + entryCutM)

// ==================== PRIMARY ENTRY ====================
longConfirm  = not confirmBreakout or (close[1] > longBrk and (close >= open or not requireTrendCandle))
shortConfirm = not confirmBreakout or (close[1] < shortBrk and (close <= open or not requireTrendCandle))
if canTrade and not active and not firstTaken and strategy.position_size == 0
    if close > longBrk and longConfirm
        entryId := "L"
        posSh := math.round(tradeQty * shareQty)
        strategy.entry(entryId, strategy.long, qty=posSh, alert_message=f_msg("Buy", posSh))
        active := true
        tdir := 1
        inRev := false
        suppressPartial := false
        entry := close
        stop := maxCapSL > 0 ? math.max(orLow, close - maxCapSL) : orLow
        tp := close + tpDist
        beLevel := orHigh - beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := tradeQty
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primDir := 1
        firstTaken := true
        if showLabels
            label.new(bar_index, low, "LONG " + str.tostring(close, format.mintick), style=label.style_label_up, color=color.rgb(7,170,75), textcolor=color.white, size=size.small)
    else if close < shortBrk and shortConfirm
        entryId := "S"
        posSh := math.round(tradeQty * shareQty)
        strategy.entry(entryId, strategy.short, qty=posSh, alert_message=f_msg("Sell", posSh))
        active := true
        tdir := -1
        inRev := false
        suppressPartial := false
        entry := close
        stop := maxCapSL > 0 ? math.min(orHigh, close + maxCapSL) : orHigh
        tp := close - tpDist
        beLevel := orLow + beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := tradeQty
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primDir := -1
        firstTaken := true
        if showLabels
            label.new(bar_index, high, "SHORT " + str.tostring(close, format.mintick), style=label.style_label_down, color=color.rgb(243,76,76), textcolor=color.white, size=size.small)

// ==================== STATE DE-SYNC + REVERSAL ARMING (runs BEFORE the reversal entry) ============
// The OCO fills INTRABAR and is detected on the NEXT bar (position flat, active still true). This block
// MUST run before the reversal-entry block: a primary stop that fills on bar N is then armed here on N+1
// and the reversal can fire the SAME bar (N+1), matching orb_engine.py / the indicator. (When it ran
// AFTER the reversal block, arming happened a bar too late and the reversal entered ~1 bar worse -> it
// bled the reversal edge, ~35% of net.) Arm only on a BASE/BE STOP (reasons Base SL/BE Stop/BE Trail,
// L933): a peak-trail exit is reason "Trail" (lastWasTrail) and does NOT arm; C2 arms unless a TP win.
if active and strategy.position_size == 0 and bar_index > entryBar
    // C2 win detection must be race-proof: TV reflects the intrabar OCO fill in position_size
    // on the SAME bar, so this block can run BEFORE the exit-engine mirror sets tpWasHit. Also
    // test the current bar's target touch inline so a TP win never arms a phantom reversal.
    c2Won = tpWasHit or (not na(tp) and (tdir == 1 ? high >= tp : low <= tp))
    stoppedOut = usePartial ? (not lastWasTrail) : (not c2Won)
    if not inRev and stoppedOut
        primStopped := true
        if showLabels
            label.new(bar_index, tdir == 1 ? low : high, "REV armed: need close " + (tdir == 1 ? "< " + str.tostring(orLow, format.mintick) : "> " + str.tostring(orHigh, format.mintick)), style=tdir == 1 ? label.style_label_up : label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
    strategy.cancel("P1")
    strategy.cancel("RUN")
    strategy.cancel("X")
    active := false
    tdir := 0
    inRev := false
    tp := na
    stop := na
    vwapArmed := false

// ==================== REVERSAL ENTRY (raw OR break · trail-to-EOD · risk-parity · NO target) ====
if canTrade and primStopped and not active and strategy.position_size == 0
    if primDir == 1 and close < orLow
        rpu = math.abs(close - orHigh)
        rq = revRiskCap > 0 and rpu > 0 ? math.min(tradeQty * revQtyMult, revRiskCap / rpu) : tradeQty * revQtyMult
        entryId := "RS"
        posSh := math.round(rq * shareQty)
        strategy.entry(entryId, strategy.short, qty=posSh, alert_message=f_msg("Sell", posSh))
        active := true
        tdir := -1
        inRev := true
        suppressPartial := true
        entry := close
        stop := orHigh
        tp := na
        beLevel := orLow + beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := rq
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primStopped := false
        if showLabels
            label.new(bar_index, high, "REV SHORT " + str.tostring(close, format.mintick) + "\nqty " + str.tostring(rq, "#.##"), style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)
    else if primDir == -1 and close > orHigh
        rpu = math.abs(close - orLow)
        rq = revRiskCap > 0 and rpu > 0 ? math.min(tradeQty * revQtyMult, revRiskCap / rpu) : tradeQty * revQtyMult
        entryId := "RL"
        posSh := math.round(rq * shareQty)
        strategy.entry(entryId, strategy.long, qty=posSh, alert_message=f_msg("Buy", posSh))
        active := true
        tdir := 1
        inRev := true
        suppressPartial := true
        entry := close
        stop := orLow
        tp := na
        beLevel := orHigh - beTrigger * orWidth
        entryBar := bar_index
        qtyTotal := rq
        beTrig := false
        part1 := false
        tpWasHit := false
        runnerPeak := na
        vwapArmed := false
        primStopped := false
        if showLabels
            label.new(bar_index, low, "REV LONG " + str.tostring(close, format.mintick) + "\nqty " + str.tostring(rq, "#.##"), style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.small)

// ==================== EXIT ENGINE — OCO brackets (never on the entry bar) ====================
if active and not na(stop) and bar_index >= entryBar
    vwapExited = false
    stopBarStart = stop        // the stop actually RESTING coming into this bar (pre BE-retrace)
    beFiredNow = false
    if bar_index > entryBar
        // Step 1: BE Retrace (WICK trigger)
        if not beTrig and not na(beLevel)
            if (tdir == 1 ? low <= beLevel : high >= beLevel)
                stop := tdir == 1 ? math.max(stop, entry) : math.min(stop, entry)
                beTrig := true
                beFiredNow := true
        // Step 2: BE Trail
        if beTrig and beTrailAmt > 0
            stop := tdir == 1 ? math.max(stop, high - beTrailAmt) : math.min(stop, low + beTrailAmt)
        if usePartial
            // Step 3: mirror the 25% partial fill (P1 limit does the actual fill)
            if not suppressPartial and not part1 and not na(tp) and (tdir == 1 ? high >= tp : low <= tp)
                part1 := true
                tp := na
                if showLabels
                    label.new(bar_index, tdir == 1 ? high : low, d1FullTrail ? "TRAIL ARMED" : "PARTIAL " + str.tostring(partialPct, "#") + "%", style=tdir == 1 ? label.style_label_down : label.style_label_up, color=d1FullTrail ? color.new(color.yellow, 30) : color.rgb(7,170,75), textcolor=d1FullTrail ? color.black : color.white, size=size.tiny)
            // Step 4a: runner peak-trail level (A1; D1 uses the ATR trail in Step 4c instead)
            if part1 and not suppressPartial and not runnerVWAP and not isD1 and runnerMult > 0
                runnerPeak := na(runnerPeak) ? (tdir == 1 ? high : low) : (tdir == 1 ? math.max(runnerPeak, high) : math.min(runnerPeak, low))
            // Step 4b: runner VWAP-cross exit (B1/C1)
            if part1 and not suppressPartial and runnerVWAP
                if not vwapArmed and (tdir == 1 ? close - entry : entry - close) >= vwapArmProfit
                    vwapArmed := true
                if vwapArmed and not na(sessVwap) and (tdir == 1 ? close <= sessVwap : close >= sessVwap)
                    strategy.cancel("P1")
                    strategy.cancel("RUN")
                    strategy.close(entryId, comment=(inRev ? "REV VWAP" : "VWAP Cross"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
                    if showLabels
                        label.new(bar_index, tdir == 1 ? high : low, (inRev ? "REV " : "") + "VWAP " + str.tostring(close, format.mintick), style=tdir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.aqua, 0), textcolor=color.white, size=size.small)
                    active := false
                    tdir := 0
                    inRev := false
                    tp := na
                    stop := na
                    vwapArmed := false
                    vwapExited := true
            // Step 4c: runner ATR-trail exit (D1) — the TRADE TASTIC color flip: long exits
            // close <= TS (green->red), short exits close > TS (red->green; SAME line)
            if part1 and not suppressPartial and isD1 and (tdir == 1 ? close <= ttTS : close > ttTS)
                strategy.cancel("P1")
                strategy.cancel("RUN")
                strategy.close(entryId, comment=(inRev ? "REV ATR Trail" : "ATR Trail"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
                if showLabels
                    label.new(bar_index, tdir == 1 ? high : low, (inRev ? "REV " : "") + "ATR TRAIL " + str.tostring(close, format.mintick), style=tdir == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)
                active := false
                tdir := 0
                inRev := false
                tp := na
                stop := na
                vwapExited := true   // reuse the exited-this-bar flag: skip the bracket refresh below
        else
            // C2 full exit: mirror the target touch so a TP win does not arm the reversal
            if not na(tp) and (tdir == 1 ? high >= tp : low <= tp)
                tpWasHit := true
    if not vwapExited
        // Wick-mode resting-stop realism: a BE-retrace that fired THIS bar rests only from the NEXT bar.
        restStop = (beRealistic and beFiredNow) ? stopBarStart : stop
        beReason = beTrig ? ((tdir == 1 ? restStop > entry : restStop < entry) ? "BE Trail" : "BE Stop") : "Base SL"
        partSh = d1FullTrail ? 0 : math.round(posSh * partialPct / 100)   // whole-share 25% partial; runner takes the remainder (D1 full-trail: nothing off at TP)
        runSh  = posSh - partSh
        trailLevel = (usePartial and part1 and not suppressPartial and not runnerVWAP and not isD1 and runnerMult > 0 and not na(runnerPeak)) ? (tdir == 1 ? runnerPeak - runnerMult * orWidth : runnerPeak + runnerMult * orWidth) : na
        isTrail = not na(trailLevel) and (tdir == 1 ? trailLevel >= stop : trailLevel <= stop)
        if usePartial and part1 and not suppressPartial
            lastWasTrail := isTrail
        else if usePartial
            lastWasTrail := false
        // stop level governing the remaining position this bar (A1 runner-trail folded in)
        curStop = not na(trailLevel) ? (tdir == 1 ? math.max(stop, trailLevel) : math.min(stop, trailLevel)) : stop
        // CLOSE-triggered stop: fire only when the bar CLOSES beyond the level -> flatten at the close.
        // No manual reset — the de-sync block arms the reversal next bar (a "Trail" exit does not arm).
        if stopClose and (tdir == 1 ? close <= curStop : close >= curStop)
            strategy.cancel("P1")
            strategy.cancel("RUN")
            strategy.cancel("X")
            strategy.close(entryId, comment=(inRev ? "REV " : "") + (isTrail ? "Trail" : beReason), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
        else
            // Close mode: rest the TP limits only (stops are close-triggered above). Wick mode: OCO w/ resting stops.
            if not usePartial
                strategy.exit("X", from_entry=entryId, stop=(stopClose ? na : restStop), limit=tp, comment_loss=(inRev ? "REV " : "") + beReason, comment_profit=(inRev ? "REV TP" : "TP"), alert_message=f_msg("Exit", posSh))
            else if suppressPartial
                if not stopClose
                    strategy.exit("RUN", from_entry=entryId, stop=restStop, comment=(inRev ? "REV " : "") + beReason, alert_message=f_msg("Exit", posSh))
            else if not part1 and d1FullTrail
                // D1 full-trail: NO TP order at all — the target touch only ARMS the trail (the
                // Step 3 mirror flips part1); wick mode still rests the full-size protective stop
                if not stopClose
                    strategy.exit("RUN", from_entry=entryId, stop=restStop, comment=(inRev ? "REV " : "") + beReason, alert_message=f_msg("Exit", posSh))
            else if not part1
                // OPTIONS: suppress the 25% partial's webhook so the single contract HOLDS through the
                // partial and closes only at the runner's final exit (matches the A1/B1/C1 option backtest).
                // NEVER pass na here — an unset alert_message makes TV emit the LITERAL placeholder text
                // "{{strategy.order.alert_message}}" (v3.1 fix, seen live 2026-07-21). Send readable
                // non-JSON text instead: TradersPost ignores it, the TV notification stays meaningful.
                // SHARES: the partial sends its normal 25% exit. The runner/stop/VWAP/EOD full-flatten still
                // fires the option close, so nothing is missed.
                partAlert = orderAsset == "Options" ? "UDB-ORB INFO: 25% share-partial filled at target - NO OPTIONS ACTION, contract holds to the runner exit (TradersPost: ignore)" : f_msg(partialAsOrder ? (tdir == 1 ? "Sell" : "Buy") : "Exit", partSh)
                strategy.exit("P1", from_entry=entryId, qty=partSh, stop=(stopClose ? na : restStop), limit=tp, comment_loss=(inRev ? "REV " : "") + beReason, comment_profit="Partial @ TP", alert_message=partAlert)
                if not stopClose
                    strategy.exit("RUN", from_entry=entryId, qty=runSh, stop=restStop, comment=(inRev ? "REV " : "") + beReason, alert_message=f_msg("Exit", runSh))
            else
                if not stopClose
                    runnerStop = na(trailLevel) ? restStop : (tdir == 1 ? math.max(restStop, trailLevel) : math.min(restStop, trailLevel))
                    strategy.exit("RUN", from_entry=entryId, qty=runSh, stop=runnerStop, comment=(inRev ? "REV " : "") + (isTrail ? "Trail" : beReason), alert_message=f_msg("Exit", runSh))

// ==================== EOD FORCED CLOSE ====================
if active and isFlattenBar and tdir != 0
    strategy.cancel("P1")
    strategy.cancel("RUN")
    strategy.cancel("X")
    strategy.close(entryId, comment=(inRev ? "REV EOD" : "EOD"), alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))
    if showLabels
        label.new(bar_index, close, (inRev ? "REV EOD " : "EOD ") + str.tostring(close, format.mintick), style=label.style_label_left, color=color.rgb(255,140,0), textcolor=color.white, size=size.small)
    active := false
    tdir := 0
    inRev := false
    tp := na
    stop := na

if strategy.position_size != 0 and isFlattenBar and not active
    strategy.close_all(comment="EOD flat", alert_message=f_msg("Exit", math.round(math.abs(strategy.position_size))))

// ==================== VISUALS ====================
plot(showLevels and not daySkipped and not na(orHigh) ? orHigh : na, "OR High", color=color.new(color.aqua, 0), style=plot.style_linebr)
plot(showLevels and not daySkipped and not na(orLow) ? orLow : na, "OR Low", color=color.new(color.aqua, 0), style=plot.style_linebr)
plot(showLevels and not daySkipped and not na(longBrk) ? longBrk : na, "Long Trigger", color=color.new(color.lime, 0), style=plot.style_linebr)
plot(showLevels and not daySkipped and not na(shortBrk) ? shortBrk : na, "Short Trigger", color=color.new(color.red, 0), style=plot.style_linebr)
plot(active ? stop : na, "Active Stop", color=color.red, linewidth=2, style=plot.style_linebr)
plot(active and not na(tp) ? tp : na, "Active TP", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(active and not beTrig and not na(beLevel) ? beLevel : na, "BE Trigger", color=color.new(color.yellow, 0), style=plot.style_circles)
plot(primStopped and not active ? (primDir == 1 ? orLow : orHigh) : na, "Reversal Trigger", color=color.new(color.purple, 0), linewidth=2, style=plot.style_circles)
bgcolor(daySkipped ? color.new(color.gray, 90) : na, title="Day skipped (vol regime / wide OR)")

// ---- PRIOR-DAY LEVELS (v3.9.3) — four distinct COLOURS *and* four distinct PATTERNS ----
//   PDH magenta thick solid | PDL blue thick solid | PDC white dotted | PDO orange x-marks
cPDH = color.new(color.fuchsia, 0)
cPDL = color.new(color.rgb(41, 98, 255), 0)
cPDC = color.new(color.white, 0)
cPDO = color.new(color.orange, 0)
plot(showPD and showPDH and not na(pdH) ? pdH : na, "PDH — prior day High",  color=cPDH, linewidth=2, style=plot.style_stepline)
plot(showPD and showPDL and not na(pdL) ? pdL : na, "PDL — prior day Low",   color=cPDL, linewidth=2, style=plot.style_stepline)
plot(showPD and showPDC and not na(pdC) ? pdC : na, "PDC — prior day Close", color=cPDC, linewidth=1, style=plot.style_circles)
plot(showPD and showPDO and not na(pdO) ? pdO : na, "PDO — prior day Open",  color=cPDO, linewidth=1, style=plot.style_cross)

// right-edge tags: 4 label objects that are MOVED, never re-created (no drain on the 500-label cap)
f_pdTag(label lb, bool show, float y, string txt, color col, color tcol) =>
    label r = lb
    if show and not na(y)
        if na(r)
            r := label.new(bar_index, y, txt, style=label.style_label_left, color=col, textcolor=tcol, size=size.tiny)
        label.set_xy(r, bar_index, y)
        label.set_text(r, txt)
    else if not na(r)
        label.delete(r)
        r := na
    r
var label lbPDH = na
var label lbPDL = na
var label lbPDC = na
var label lbPDO = na
if barstate.islast
    pdOn = showPD and showPDLbl
    lbPDH := f_pdTag(lbPDH, pdOn and showPDH, pdH, "PDH " + str.tostring(pdH, format.mintick), cPDH, color.white)
    lbPDL := f_pdTag(lbPDL, pdOn and showPDL, pdL, "PDL " + str.tostring(pdL, format.mintick), cPDL, color.white)
    lbPDC := f_pdTag(lbPDC, pdOn and showPDC, pdC, "PDC " + str.tostring(pdC, format.mintick), cPDC, color.black)
    lbPDO := f_pdTag(lbPDO, pdOn and showPDO, pdO, "PDO " + str.tostring(pdO, format.mintick), cPDO, color.black)

// ==================== INFO TABLE ====================
var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "UDB-ORB v3.9.3", text_color=color.white, bgcolor=color.rgb(30,30,50), text_size=size.small)
    table.cell(t, 1, 0, str.substring(profile, 0, 2), text_color=color.aqua, bgcolor=color.rgb(30,30,50), text_size=size.small)
    table.cell(t, 0, 1, "TP mode / Max Stop", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 1, tpModeSel + " / $" + str.tostring(maxCapSL, "#"), text_color=color.aqua, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 2, "Today's TP dist", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 2, na(tpDist) ? "n/a" : "$" + str.tostring(tpDist, "#.##"), text_color=color.aqua, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 3, "RVol (gate ≤ " + str.tostring(maxRvolPct, "#.##") + "%)", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 3, na(rvol20) ? "n/a" : str.tostring(rvol20, "#.##") + "%", text_color=skipVol ? color.red : color.lime, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 0, 4, "Today", text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
    table.cell(t, 1, 4, daySkipped ? "SKIPPED" : "tradable", text_color=daySkipped ? color.red : color.lime, bgcolor=color.rgb(25,25,25), text_size=size.small)
